---
// 图：功耗账——单卡 TDP 代际攀升 + 机柜密度三档（示意比例，非实测曲线）
---

<figure>
  <svg viewBox="0 0 640 268" width="100%" xmlns="http://www.w3.org/2000/svg">
    <g font-family="-apple-system,'PingFang SC','Microsoft YaHei',sans-serif">
      <text x="320" y="24" font-size="14" font-weight="bold" fill="#0c5f74" text-anchor="middle">算力也是电力账：单卡越来越能「吃」电，机柜从个位数 kW 涨到上百 kW</text>

      {/* 左：单卡 */}
      <text x="170" y="56" font-size="11.5" font-weight="bold" fill="#334155" text-anchor="middle">单卡 TDP（SXM/HGX 高配）</text>
      {[
        {name:"A100", v:400, h:44},
        {name:"H100", v:700, h:77},
        {name:"B200", v:1000, h:110},
        {name:"B300", v:1400, h:140},
      ].map((d,i)=>{
        const x = 66+i*58, baseY = 210;
        return (
          <g>
            <rect x={x} y={baseY-d.h} width="40" height={d.h} rx="4" fill={i>=2 ? "#e6a23c" : "#7fc3d8"} opacity="0.9"/>
            <text x={x+20} y={baseY-d.h-7} font-size="9.5" font-weight="bold" fill="#334155" text-anchor="middle">{d.v}W</text>
            <text x={x+20} y={baseY+16} font-size="9.5" fill="#475569" text-anchor="middle">{d.name}</text>
          </g>
        );
      })}

      <line x1="310" y1="66" x2="310" y2="226" stroke="#e2e8f0" stroke-dasharray="4,4"/>

      {/* 右：机柜三档 */}
      <text x="470" y="56" font-size="11.5" font-weight="bold" fill="#334155" text-anchor="middle">单机柜功率密度（典型区间）</text>
      {[
        {y:86,  t:"老机房", r:"3–5 kW", w:14, c:"#cbd5e1", tc:"#475569"},
        {y:128, t:"新建通用机房", r:"7–15 kW", w:40, c:"#7fc3d8", tc:"#006377"},
        {y:170, t:"AI 机柜", r:"20–142 kW", w:180, c:"#e6a23c", tc:"#b97a1f"},
      ].map((d)=>{
        const x = 350;
        return (
          <g>
            <text x="342" y={d.y+15} font-size="9.5" fill="#475569" text-anchor="end">{d.t}</text>
            <rect x={x} y={d.y} width={d.w} height="26" rx="4" fill={d.c} opacity="0.85"/>
            <text x={x+d.w+8} y={d.y+17} font-size="10" font-weight="bold" fill={d.tc}>{d.r}</text>
          </g>
        );
      })}
      <text x="330" y="230" font-size="9" fill="#94a3b8">AI 机柜条为数量级示意（20–142kW 跨近一个数量级）</text>
      <text x="330" y="244" font-size="9" fill="#94a3b8">120kW 级风冷不可行，需冷板式液冷</text>
    </g>
  </svg>
</figure>
