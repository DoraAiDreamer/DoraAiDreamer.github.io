---
// 图4：思考预算与正确率——三种难度任务的不同形态（示意，非实测数据）
// 易题：高位微降；中难题：上升后平台；极难题：低位平台
// 第二面板：并行采样数轴（self-consistency / best-of-n）
---

<figure>
  <svg viewBox="0 0 640 330" width="100%" xmlns="http://www.w3.org/2000/svg">
    <g font-family="-apple-system,'PingFang SC','Microsoft YaHei',sans-serif">
      <text x="200" y="24" font-size="13.5" font-weight="bold" fill="#0c5f74" text-anchor="middle">单链思考预算 → 正确率（示意，非实测）</text>
      <text x="540" y="24" font-size="12" font-weight="bold" fill="#0c5f74" text-anchor="middle">另一根杠杆：并行采样</text>

      {/* ===== 左面板坐标系 ===== */}
      <g>
        <line x1="56" y1="250" x2="372" y2="250" stroke="#94a3b8" stroke-width="1.4"/>
        <line x1="56" y1="250" x2="56" y2="50" stroke="#94a3b8" stroke-width="1.4"/>
        <text x="214" y="276" font-size="11" fill="#64748b" text-anchor="middle">单条思维链长度（token，示意）→</text>
        <text x="26" y="150" font-size="11" fill="#64748b" text-anchor="middle" transform="rotate(-90 26 150)">正确率</text>

        {/* 区间底色：有效 / 递减 / 反噬 */}
        <rect x="56" y="50" width="105" height="200" fill="#e4f5ec" opacity="0.55"/>
        <rect x="161" y="50" width="105" height="200" fill="#fdf6e3" opacity="0.6"/>
        <rect x="266" y="50" width="106" height="200" fill="#fbe3e3" opacity="0.45"/>
        <text x="108" y="66" font-size="10" fill="#0a7a50" text-anchor="middle">有效区</text>
        <text x="213" y="66" font-size="10" fill="#b97a1f" text-anchor="middle">边际递减</text>
        <text x="319" y="66" font-size="10" fill="#b14a4a" text-anchor="middle">可能反噬？</text>

        {/* 中难题：上升后平台 */}
        <path d="M56,226 C96,210 118,170 150,140 C182,112 214,100 250,96 C292,92 330,92 372,92"
              fill="none" stroke="#0085a1" stroke-width="2.6"/>
        <text x="356" y="112" font-size="10.5" fill="#0085a1" text-anchor="end">中难题</text>

        {/* 易题：起点高，几乎平，尾部微降 */}
        <path d="M56,86 C110,84 180,86 250,90 C300,94 340,102 372,108"
              fill="none" stroke="#0f9d68" stroke-width="2.4"/>
        <text x="70" y="80" font-size="10.5" fill="#0f9d68">易题（多想反而引入错误）</text>

        {/* 极难题：低位平台 */}
        <path d="M56,236 C120,234 200,232 280,231 C320,231 350,230 372,230"
              fill="none" stroke="#b14a4a" stroke-width="2.4" stroke-dasharray="6,4"/>
        <text x="356" y="224" font-size="10.5" fill="#b14a4a" text-anchor="end">极难（不会就是不会）</text>

        {/* 反噬区问号 */}
        <text x="319" y="140" font-size="20" fill="#b14a4a" text-anchor="middle" opacity="0.7">?</text>
      </g>

      {/* ===== 右面板：并行采样 ===== */}
      <g>
        <line x1="430" y1="250" x2="612" y2="250" stroke="#94a3b8" stroke-width="1.4"/>
        {[1,4,8,16].map((n,i)=>{
          const x = 452 + i*48;
          return (
            <g>
              <text x={x} y="268" font-size="10" fill="#64748b" text-anchor="middle">×{n}</text>
              {Array.from({length: Math.min(n,8)}).map((_,j)=>(
                <line x1={x-14} y1={238-j*4} x2={x+14} y2={238-j*4} stroke="#7ec3d8" stroke-width="1.6"/>
              ))}
            </g>
          );
        })}
        <text x="524" y="192" font-size="10" fill="#006377" text-anchor="middle">k 条独立采样</text>
        <text x="524" y="205" font-size="10" fill="#006377" text-anchor="middle">→ 对最终答案投票</text>
        <text x="521" y="292" font-size="10.5" fill="#64748b" text-anchor="middle">采样条数（成本 ×n，需要温度&gt;0 才有多样性）</text>

        <rect x="430" y="56" width="182" height="92" rx="8" fill="#f7fbfc" stroke="#e2e8f0"/>
        <text x="442" y="78" font-size="10.5" fill="#334155">pass@1：抽 1 次的正确率</text>
        <text x="442" y="100" font-size="10.5" fill="#334155">pass@k：k 条里至少 1 条对</text>
        <text x="442" y="122" font-size="10.5" fill="#334155">majority@k：k 条答案投票</text>
        <text x="442" y="142" font-size="10" fill="#94a3b8">比较模型时三者必须对齐</text>
      </g>
    </g>
  </svg>
</figure>
