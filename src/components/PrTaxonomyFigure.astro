---
// 粒度谱系：同一权重矩阵上六种剪枝零排布；前三类不缩形、后三类物理缩形
---

<figure>
  <svg viewBox="0 0 640 306" width="100%" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <line x1="30" y1="256" x2="610" y2="256" stroke="#94a3b8" stroke-width="1.4"/>
      <marker id="prt-arw" markerWidth="8" markerHeight="8" refX="6" refY="3" orient="auto"><path d="M0,0 L7,3 L0,6 Z" fill="#94a3b8"/></marker>
    </defs>
    <g font-family="-apple-system,'PingFang SC','Microsoft YaHei',sans-serif">
      <text x="320" y="22" font-size="14" font-weight="bold" fill="#0c5f74" text-anchor="middle">剪枝粒度：零长在哪，决定能不能变快</text>

      <text x="150" y="52" font-size="10.5" font-weight="bold" fill="#006377">不缩形（命运在 kernel）</text>
      <text x="490" y="52" font-size="10.5" font-weight="bold" fill="#0a7a50">物理缩形（dense BLAS 直接受益）</text>

      {(() => {
        const cell=11, gap=1, x0=40, y0=66;
        const mk=(ox,oy,kind)=>{
          const rects=[];
          for(let r=0;r<8;r++) for(let c=0;c<8;c++){
            const x=ox+c*(cell+gap), y=oy+r*(cell+gap);
            let zero=false;
            if(kind==="unstruct") zero=(r*7+c*3)%5<2;
            if(kind==="nm") zero=[1,2].includes(c%4);
            if(kind==="block") zero=(c>=2&&c<=3)&&(r>=2&&r<=5);
            if(kind==="channel") zero=(c===6||c===7);
            if(kind==="head") zero=(r>=4&&c>=4);
            if(kind==="layer") zero=(r===7);
            rects.push(<rect x={x} y={y} width={cell} height={cell} rx="1.5" fill={zero?"#fff":"#7fc3d8"} stroke={zero?"#cbd5e1":"#0085a1"} stroke-width="0.5"/>);
          }
          return rects;
        };
        const items=[
          {x:x0,     y:y0,      t:"非结构化", k:"unstruct", c:"#006377"},
          {x:x0+150, y:y0,      t:"N:M 半结构化", k:"nm", c:"#006377"},
          {x:x0+300, y:y0,      t:"块稀疏", k:"block", c:"#006377"},
          {x:x0,     y:y0+118,  t:"通道/filter", k:"channel", c:"#0a7a50"},
          {x:x0+150, y:y0+118,  t:"注意力头", k:"head", c:"#0a7a50"},
          {x:x0+300, y:y0+118,  t:"层 / 深度", k:"layer", c:"#0a7a50"},
        ];
        return items.map((it)=>(
          <g>
            {mk(it.x,it.y,it.k)}
            <text x={it.x+48} y={it.y+116} font-size="9.5" font-weight="bold" fill={it.c} text-anchor="middle">{it.t}</text>
          </g>
        ));
      })()}

      <text x="320" y="248" font-size="9" fill="#64748b" text-anchor="middle">规则度 →</text>
      <line x1="30" y1="256" x2="600" y2="256" marker-end="url(#prt-arw)"/>
      <text x="60" y="278" font-size="8.5" fill="#94a3b8">稀疏率可很高，但形状不变、打不过接近峰值的 cuBLAS</text>
      <text x="600" y="278" font-size="8.5" fill="#94a3b8" text-anchor="end">矩阵行列变短，任意后端少算；但精度代价与冗余假设更强</text>
    </g>
  </svg>
</figure>
