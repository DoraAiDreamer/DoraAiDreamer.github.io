---
// 图：同一个权重矩阵上的六种剪枝粒度 + 底部一行「存储形状」缩略
---

<figure>
  <svg viewBox="0 0 640 306" width="100%" xmlns="http://www.w3.org/2000/svg">
    <g font-family="-apple-system,'PingFang SC','Microsoft YaHei',sans-serif">
      <text x="320" y="22" font-size="14" font-weight="bold" fill="#0c5f74" text-anchor="middle">同一个权重矩阵，零长在哪，决定能不能变快</text>

      {(() => {
        // 8x8 网格单元，六种排布
        const cell=11;
        const draw=(ox:number, oy:number, kind:string)=>{
          const els=[];
          for(let r=0;r<8;r++)for(let c=0;c<8;c++){
            let zero=false;
            if(kind==="unstruct") zero=(r*5+c*3+r*c)%2===0;
            else if(kind==="2:4") zero=(c%4===1||c%4===2);
            else if(kind==="block"){ const br=Math.floor(r/2), bc=Math.floor(c/2); zero=(br+bc)%2===1; }
            else if(kind==="channel") zero=c>=6;
            else if(kind==="head") zero=(r>=2&&r<=3)||(r>=6&&r<=7);
            else if(kind==="layer") zero=false;
            els.push(<rect x={ox+c*cell} y={oy+r*cell} width={cell-1.5} height={cell-1.5} rx="1.5"
              fill={zero?"#fff":"#7fc3d8"} stroke={zero?"#cbd5e1":"#0085a1"} stroke-width="0.5"
              stroke-dasharray={zero?"2,2":undefined}/>);
          }
          return els;
        };
        const items=[
          {t:"非结构化", k:"unstruct", note:"零随机散布"},
          {t:"N:M（2:4）", k:"2:4", note:"每 4 格固定 2 零"},
          {t:"块稀疏", k:"block", note:"整块整团为零"},
          {t:"通道/filter", k:"channel", note:"整列整核删除"},
          {t:"注意力头", k:"head", note:"整行分组删除"},
          {t:"层/隐藏维", k:"layer", note:"整张矩阵搬走"},
        ];
        return items.map((it,i)=>{
          const col=i%3, row=Math.floor(i/3);
          const ox=70+col*180, oy=40+row*128;
          return (
            <g>
              {draw(ox,oy,it.k)}
              <text x={ox+44} y={oy-8} font-size="10.5" font-weight="bold" fill="#006377" text-anchor="middle">{it.t}</text>
              <text x={ox+44} y={oy+100} font-size="8.5" fill="#94a3b8" text-anchor="middle">{it.note}</text>
              {it.k==="layer" && <g>
                <rect x={ox-3} y={oy-3} width="94" height="94" rx="4" fill="none" stroke="#e67e7e" stroke-width="1.5" stroke-dasharray="4,3"/>
                <text x={ox+44} y={oy+48} font-size="9" fill="#b14a4a" text-anchor="middle">矩阵移除</text>
              </g>}
            </g>
          );
        });
      })()}

      <line x1="30" y1="278" x2="610" y2="278" stroke="#e2e8f0"/>
      <text x="34" y="296" font-size="9.5" fill="#64748b">存储形状：前三类矩阵形状不变（命运取决于稀疏 kernel 是否跳零）；后三类物理缩形，dense BLAS 直接少算</text>
    </g>
  </svg>
</figure>
