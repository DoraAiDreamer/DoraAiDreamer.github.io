---
// 图2：PD 架构三部件与三色数据路径——黑控制面、橙 KV 专线、绿 token 流
---

<figure>
  <svg viewBox="0 0 640 302" width="100%" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <marker id="pd2b-arw" markerWidth="9" markerHeight="9" refX="6.5" refY="3" orient="auto"><path d="M0,0 L7,3 L0,6 Z" fill="#475569"/></marker>
      <marker id="pd2b-kv" markerWidth="10" markerHeight="10" refX="7" refY="3.5" orient="auto"><path d="M0,0 L8,3.5 L0,7 Z" fill="#e6a23c"/></marker>
      <marker id="pd2b-tok" markerWidth="9" markerHeight="9" refX="6.5" refY="3" orient="auto"><path d="M0,0 L7,3 L0,6 Z" fill="#0f9d68"/></marker>
    </defs>
    <g font-family="-apple-system,'PingFang SC','Microsoft YaHei',sans-serif">
      <text x="320" y="24" font-size="14" font-weight="bold" fill="#0c5f74" text-anchor="middle">PD 分离长什么样：文本绕前台，KV 走专线</text>

      {/* 客户端 */}
      <rect x="22" y="128" width="82" height="56" rx="10" fill="#f4f6f8" stroke="#94a3b8" stroke-width="1.5"/>
      <text x="63" y="152" font-size="11" font-weight="bold" fill="#334155" text-anchor="middle">客户端</text>
      <text x="63" y="168" font-size="8.5" fill="#64748b" text-anchor="middle">发 prompt</text>

      {/* 路由器 */}
      <rect x="168" y="118" width="100" height="76" rx="10" fill="#ffffff" stroke="#475569" stroke-width="1.6"/>
      <text x="218" y="148" font-size="11.5" font-weight="bold" fill="#334155" text-anchor="middle">代理路由器</text>
      <text x="218" y="164" font-size="8.5" fill="#64748b" text-anchor="middle">proxy / router</text>
      <text x="218" y="178" font-size="8.5" fill="#64748b" text-anchor="middle">选 P、再选 D</text>

      {/* P 池 */}
      <rect x="406" y="42" width="214" height="94" rx="11" fill="#f2f8fa" stroke="#0085a1" stroke-width="1.5"/>
      <text x="513" y="62" font-size="11" font-weight="bold" fill="#006377" text-anchor="middle">Prefill 池 · 大 TP · 高算力卡</text>
      {[0,1,2].map((i)=>(
        <g>
          <rect x={424+i*62} y="74" width="50" height="44" rx="7" fill="#d9eef3" stroke="#0085a1"/>
          <text x={449+i*62} y="94" font-size="9.5" fill="#006377" text-anchor="middle">P{i+1}</text>
          <text x={449+i*62} y="108" font-size="8" fill="#006377" text-anchor="middle">读 prompt</text>
        </g>
      ))}

      {/* D 池 */}
      <rect x="406" y="178" width="214" height="94" rx="11" fill="#fffaf2" stroke="#e6a23c" stroke-width="1.5"/>
      <text x="513" y="198" font-size="11" font-weight="bold" fill="#b97a1f" text-anchor="middle">Decode 池 · 多副本 · 大 KV 池</text>
      {[0,1,2].map((i)=>(
        <g>
          <rect x={424+i*62} y="210" width="50" height="44" rx="7" fill="#fdf0e0" stroke="#e6a23c"/>
          <text x={449+i*62} y="230" font-size="9.5" fill="#b97a1f" text-anchor="middle">D{i+1}</text>
          <text x={449+i*62} y="244" font-size="8" fill="#b97a1f" text-anchor="middle">逐词生成</text>
        </g>
      ))}

      {/* ① client → router 黑 */}
      <line x1="104" y1="146" x2="164" y2="150" stroke="#475569" stroke-width="1.6" marker-end="url(#pd2b-arw)"/>
      <text x="134" y="138" font-size="8.5" fill="#475569" text-anchor="middle">① 请求</text>

      {/* ② router → P 黑虚线 */}
      <line x1="268" y1="132" x2="402" y2="92" stroke="#475569" stroke-width="1.5" stroke-dasharray="5,3" marker-end="url(#pd2b-arw)"/>
      <text x="340" y="82" font-size="8.5" fill="#475569" text-anchor="middle" stroke="#ffffff" stroke-width="3.2" paint-order="stroke">② 副本请求（max_tokens=1）</text>

      {/* ③ P → router 参数 黑虚线回流：折线从 P 池下缘绕回路由器右侧，避开文字 */}
      <path d="M402,126 L300,126 L300,172 L272,172" fill="none" stroke="#475569" stroke-width="1.3" stroke-dasharray="3,3" marker-end="url(#pd2b-arw)"/>
      <text x="350" y="121" font-size="8.5" fill="#475569" text-anchor="middle" stroke="#ffffff" stroke-width="3.2" paint-order="stroke">③ 握手参数（KV 在哪）</text>

      {/* KV 专线 P→D 橙粗 */}
      <line x1="513" y1="140" x2="513" y2="172" stroke="#e6a23c" stroke-width="5" marker-end="url(#pd2b-kv)"/>
      <text x="524" y="161" font-size="8.5" fill="#b97a1f">KV 走 RDMA 专线</text>

      {/* ④ D → router 绿 token */}
      <line x1="402" y1="226" x2="272" y2="182" stroke="#0f9d68" stroke-width="1.8" marker-end="url(#pd2b-tok)"/>
      <text x="350" y="220" font-size="8.5" fill="#0a7a50" text-anchor="middle">④ 逐词 token 流（SSE）</text>

      {/* router → client 绿 */}
      <line x1="164" y1="172" x2="108" y2="166" stroke="#0f9d68" stroke-width="1.8" marker-end="url(#pd2b-tok)"/>
      <text x="135" y="188" font-size="8.5" fill="#0a7a50" text-anchor="middle">⑤ 流式返回</text>

      {/* 图例 */}
      <line x1="150" y1="290" x2="182" y2="290" stroke="#475569" stroke-width="1.6" stroke-dasharray="5,3"/>
      <text x="188" y="293" font-size="9" fill="#475569">控制面（HTTP 请求/参数）</text>
      <line x1="342" y1="290" x2="374" y2="290" stroke="#e6a23c" stroke-width="4.5"/>
      <text x="380" y="293" font-size="9" fill="#b97a1f">KV 数据面（RDMA）</text>
      <line x1="500" y1="290" x2="532" y2="290" stroke="#0f9d68" stroke-width="2"/>
      <text x="538" y="293" font-size="9" fill="#0a7a50">token 流</text>
    </g>
  </svg>
</figure>
