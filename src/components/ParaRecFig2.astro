<svg viewbox="0 0 640 352" width="100%" xmlns="http://www.w3.org/2000/svg"><g font-family="-apple-system,'PingFang SC','Microsoft YaHei',sans-serif"><text fill="#0c5f74" font-size="14" font-weight="bold" text-anchor="middle" x="320" y="22">两堵墙：容量（放不放得下）与延迟（等多久），五把刀各治一处</text><text fill="#475569" font-size="10.5" x="24" y="50">卡间地形</text><rect fill="#d9eef3" height="20" rx="4" stroke="#0085a1" width="170" x="96" y="38"></rect><text fill="#006377" font-size="10" text-anchor="middle" x="181" y="52">NVLink 域 ≈900GB/s</text><rect fill="#fdf0e0" height="20" rx="4" stroke="#e6a23c" width="140" x="272" y="38"></rect><text fill="#b97a1f" font-size="10" text-anchor="middle" x="342" y="52">PCIe ≈64GB/s</text><rect fill="#f4f6f8" height="20" rx="4" stroke="#cbd5e1" width="198" x="418" y="38"></rect><text fill="#475569" font-size="10" text-anchor="middle" x="517" y="52">InfiniBand ≈50GB/s/rail（跨机）</text><path d="M266 48 l6 0 m-3 -4 l4 4 l-4 4 m-7 -8 l6 0" fill="none" stroke="#94a3b8"></path><path d="M412 48 l6 0 m-3 -4 l4 4 l-4 4 m-7 -8 l6 0" fill="none" stroke="#94a3b8"></path><g font-family="-apple-system,'PingFang SC','Microsoft YaHei',sans-serif"><rect fill="#eef2f5" height="26" rx="4" stroke="#cbd5e1" width="52" x="24" y="72"></rect><text fill="#334155" font-size="10.5" font-weight="bold" text-anchor="middle" x="50" y="89">策略</text></g><g font-family="-apple-system,'PingFang SC','Microsoft YaHei',sans-serif"><rect fill="#eef2f5" height="26" rx="4" stroke="#cbd5e1" width="150" x="80" y="72"></rect><text fill="#334155" font-size="10.5" font-weight="bold" text-anchor="middle" x="155" y="89">物理动作</text></g><g font-family="-apple-system,'PingFang SC','Microsoft YaHei',sans-serif"><rect fill="#eef2f5" height="26" rx="4" stroke="#cbd5e1" width="132" x="234" y="72"></rect><text fill="#334155" font-size="10.5" font-weight="bold" text-anchor="middle" x="300" y="89">切什么</text></g><g font-family="-apple-system,'PingFang SC','Microsoft YaHei',sans-serif"><rect fill="#eef2f5" height="26" rx="4" stroke="#cbd5e1" width="176" x="370" y="72"></rect><text fill="#334155" font-size="10.5" font-weight="bold" text-anchor="middle" x="458" y="89">通信</text></g><g font-family="-apple-system,'PingFang SC','Microsoft YaHei',sans-serif"><rect fill="#eef2f5" height="26" rx="4" stroke="#cbd5e1" width="66" x="550" y="72"></rect><text fill="#334155" font-size="10.5" font-weight="bold" text-anchor="middle" x="583" y="89">主治</text></g><g font-family="-apple-system,'PingFang SC','Microsoft YaHei',sans-serif"><rect fill="#d9eef3" height="40" rx="6" stroke="#0085a1" width="52" x="24" y="104"></rect><text fill="#006377" font-size="13" font-weight="bold" text-anchor="middle" x="50" y="129">TP</text><text fill="#334155" font-size="10.5" text-anchor="middle" x="155" y="129">拆半算，每层合稿</text><text fill="#334155" font-size="10.5" text-anchor="middle" x="300" y="129">层内矩阵</text><text fill="#475569" font-size="10" text-anchor="middle" x="458" y="123">同组全员，每层 2 次合稿</text><text fill="#94a3b8" font-size="9" text-anchor="middle" x="458" y="137">NVLink 域</text><text fill="#334155" font-size="10" text-anchor="middle" x="583" y="129">容量+延迟</text></g><g font-family="-apple-system,'PingFang SC','Microsoft YaHei',sans-serif"><rect fill="#d9eef3" height="40" rx="6" stroke="#0085a1" width="52" x="24" y="150"></rect><text fill="#006377" font-size="13" font-weight="bold" text-anchor="middle" x="50" y="175">PP</text><text fill="#334155" font-size="10.5" text-anchor="middle" x="155" y="175">工件过工位</text><text fill="#334155" font-size="10.5" text-anchor="middle" x="300" y="175">整层</text><text fill="#475569" font-size="10" text-anchor="middle" x="458" y="169">相邻工位，边界传一次</text><text fill="#94a3b8" font-size="9" text-anchor="middle" x="458" y="183">可跨 IB</text><text fill="#334155" font-size="10" text-anchor="middle" x="583" y="175">容量（跨机）</text></g><g font-family="-apple-system,'PingFang SC','Microsoft YaHei',sans-serif"><rect fill="#e4f5ec" height="40" rx="6" stroke="#0f9d68" width="52" x="24" y="196"></rect><text fill="#0a7a50" font-size="13" font-weight="bold" text-anchor="middle" x="50" y="221">DP</text><text fill="#334155" font-size="10.5" text-anchor="middle" x="155" y="221">开 N 个相同窗口</text><text fill="#334155" font-size="10.5" text-anchor="middle" x="300" y="221">不切，整份复制</text><text fill="#475569" font-size="10" text-anchor="middle" x="458" y="215">推理时窗口间不说话</text><text fill="#94a3b8" font-size="9" text-anchor="middle" x="458" y="229">普通网络</text><text fill="#334155" font-size="10" text-anchor="middle" x="583" y="221">吞吐</text></g><g font-family="-apple-system,'PingFang SC','Microsoft YaHei',sans-serif"><rect fill="#fdf0e0" height="40" rx="6" stroke="#e6a23c" width="52" x="24" y="242"></rect><text fill="#b97a1f" font-size="13" font-weight="bold" text-anchor="middle" x="50" y="267">EP</text><text fill="#334155" font-size="10.5" text-anchor="middle" x="155" y="267">拿路由小票找专科</text><text fill="#334155" font-size="10.5" text-anchor="middle" x="300" y="267">MoE 专家</text><text fill="#475569" font-size="10" text-anchor="middle" x="458" y="261">每 MoE 层两次全员换组</text><text fill="#94a3b8" font-size="9" text-anchor="middle" x="458" y="275">吃带宽</text><text fill="#334155" font-size="10" text-anchor="middle" x="583" y="267">MoE 容量</text></g><g font-family="-apple-system,'PingFang SC','Microsoft YaHei',sans-serif"><rect fill="#f4f6f8" height="40" rx="6" stroke="#94a3b8" width="52" x="24" y="288"></rect><text fill="#475569" font-size="13" font-weight="bold" text-anchor="middle" x="50" y="313">CP</text><text fill="#334155" font-size="10.5" text-anchor="middle" x="155" y="313">分工读长文传笔记</text><text fill="#334155" font-size="10.5" text-anchor="middle" x="300" y="313">序列（token）</text><text fill="#475569" font-size="10" text-anchor="middle" x="458" y="307">逐块传阅 / 换组</text><text fill="#94a3b8" font-size="9" text-anchor="middle" x="458" y="321">越高越好</text><text fill="#334155" font-size="10" text-anchor="middle" x="583" y="313">长上下文</text></g><text fill="#334155" font-size="10.5" text-anchor="middle" x="320" y="342">五把刀可组合，但共用同一组卡、组合有约束：8 卡 = 1×TP8，也可以 = 4 个 TP2 副本（DP4）</text></g></svg>
