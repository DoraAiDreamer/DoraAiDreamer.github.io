---
// Transformer 总纲图（5 步数据流）。独立组件，避免 markdown 把裸 SVG 误解析。
// 第③块的 12 层卡片堆 + 信号流动画用 GSAP 驱动。
---
<figure>
  <svg viewBox="0 0 600 760" width="100%" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <marker id="narr" markerWidth="9" markerHeight="9" refX="5.5" refY="3" orient="auto">
        <path d="M0,0 L7,3 L0,6 Z" fill="#94a3b8"></path>
      </marker>
      <filter id="nshadow" x="-20%" y="-20%" width="140%" height="140%">
        <feDropShadow dx="0" dy="3" stdDeviation="5" flood-color="#0b2a3a" flood-opacity="0.10"></feDropShadow>
      </filter>
    </defs>

    <!-- 1 分词 -->
    <g font-family="-apple-system,'PingFang SC','Microsoft YaHei',sans-serif">
      <rect x="110" y="14" width="380" height="64" rx="16" fill="#ffffff" stroke="#e2e8f0" stroke-width="1.5" filter="url(#nshadow)"></rect>
      <circle cx="142" cy="46" r="15" fill="#94a3b8"></circle>
      <text x="142" y="51" font-size="15" font-weight="bold" fill="#fff" text-anchor="middle">1</text>
      <text x="168" y="44" font-size="15.5" font-weight="bold" fill="#1f2937">分词 Tokenize</text>
      <text x="168" y="64" font-size="12" fill="#94a3b8">把文本切成 token，映射成 ID</text>
      <g font-size="11.5" fill="#64748b">
        <rect x="366" y="32" width="34" height="28" rx="6" fill="#f1f3f5" stroke="#d6dce3"></rect>
        <text x="383" y="50" text-anchor="middle">912</text>
        <rect x="406" y="32" width="34" height="28" rx="6" fill="#f1f3f5" stroke="#d6dce3"></rect>
        <text x="423" y="50" text-anchor="middle">4031</text>
        <rect x="446" y="32" width="34" height="28" rx="6" fill="#f1f3f5" stroke="#d6dce3"></rect>
        <text x="463" y="50" text-anchor="middle">837</text>
      </g>
    </g>
    <line x1="300" y1="80" x2="300" y2="104" stroke="#94a3b8" stroke-width="2" marker-end="url(#narr)"></line>

    <!-- 2 嵌入 -->
    <g font-family="-apple-system,'PingFang SC','Microsoft YaHei',sans-serif">
      <rect x="110" y="110" width="380" height="82" rx="16" fill="#ffffff" stroke="#e2e8f0" stroke-width="1.5" filter="url(#nshadow)"></rect>
      <circle cx="142" cy="140" r="15" fill="#f0a828"></circle>
      <text x="142" y="145" font-size="15" font-weight="bold" fill="#fff" text-anchor="middle">2</text>
      <text x="168" y="140" font-size="15.5" font-weight="bold" fill="#1f2937">词嵌入 + 位置编码</text>
      <text x="168" y="160" font-size="12" fill="#94a3b8">查表得向量，再注入顺序信息</text>
      <text x="168" y="180" font-size="11" fill="#cbd5e1" font-family="Menlo,Monaco,monospace">shape [n, d]</text>
      <g>
        <rect x="372" y="158" width="9" height="24" rx="3" fill="#f6c453"></rect>
        <rect x="387" y="148" width="9" height="34" rx="3" fill="#f5a844"></rect>
        <rect x="402" y="164" width="9" height="18" rx="3" fill="#f28b4d"></rect>
        <rect x="417" y="142" width="9" height="40" rx="3" fill="#f6c453"></rect>
        <rect x="432" y="156" width="9" height="26" rx="3" fill="#f0b23b"></rect>
        <rect x="447" y="152" width="9" height="30" rx="3" fill="#ef9d4e"></rect>
      </g>
    </g>
    <line x1="300" y1="194" x2="300" y2="216" stroke="#94a3b8" stroke-width="2" marker-end="url(#narr)"></line>

    <!-- 3 Transformer Block × 12：12 层堆叠卡片（GSAP 高亮当前层，无光标） -->
    <g font-family="-apple-system,'PingFang SC','Microsoft YaHei',sans-serif" id="block-stack">
      <rect x="95" y="224" width="410" height="282" rx="18" fill="#f0f9fc" stroke="#0e87a6" stroke-width="2" filter="url(#nshadow)"></rect>

      <circle cx="124" cy="252" r="15" fill="#0e87a6"></circle>
      <text x="124" y="257" font-size="15" font-weight="bold" fill="#fff" text-anchor="middle">3</text>
      <text x="150" y="257" font-size="15.5" font-weight="bold" fill="#0c5f74">Transformer Block</text>
      <text id="layer-tip" x="486" y="257" font-size="11.5" font-weight="bold" fill="#0e87a6" text-anchor="end">× 12 层 · 自下而上 ↑</text>

      <!-- 整摞纸的"厚度"侧影（置于卡片下层） -->
      <path d="M112 472 L158 272 L172 272 L126 472 Z" fill="#dfeaf1"></path>
      <path d="M488 472 L442 272 L428 272 L474 472 Z" fill="#dfeaf1"></path>

      <!-- 12 层堆叠卡片：近大远小、近实远虚，透视收窄；每层都保留 注意力→FFN 文字 -->
      {Array.from({ length: 12 }).map((_, i) => {
        const layerNo = 12 - i;               // i=0→Block12（最顶/最远）… i=11→Block1（最底/最近）
        const t = i / 11;                     // 0=最远 → 1=最近
        const inset = 46 * (1 - t);           // 透视收窄（更强）
        const y = 270 + i * 16.5;
        const cardH = 24 + 16 * t;            // 近大远小
        const x = 112 + inset;
        const w = 376 - inset * 2;
        const midY = y + cardH / 2;
        const opacity = 0.28 + 0.72 * t;      // 近实远虚（但远处仍保留文字）
        const fs = 7.5 + 2.5 * t;             // 远处字号小但仍可见
        return (
          <g class="layer-card" data-layer={layerNo} data-base-opacity={opacity} opacity={opacity}>
            <rect class="card-body" x={x} y={y} width={w} height={cardH} rx={6 + 4 * t}
                  fill="#ffffff" stroke="#cfe0ea" stroke-width={1 + 0.5 * t}></rect>
            {/* 层号 */}
            <text x={x + 12} y={midY + fs / 2 - 1} font-size={fs} font-weight="700" fill="#5b8a96">Block{layerNo}</text>
            {/* ① 多头自注意力（紫） */}
            <rect class="bar-attn" x={x + 72} y={midY - 8} width="150" height={16} rx="5"
                  fill="#eef2ff" stroke="#7c9cf0" stroke-width="0.9"></rect>
            <text x={x + 80} y={midY + 3.5} font-size={fs} font-weight="700" fill="#4255c4">多头自注意力</text>
            {/* 箭头 */}
            <text x={x + 232} y={midY + 3.5} font-size={fs + 1} fill="#aab6ee" text-anchor="end">→</text>
            {/* ② 前馈网络 FFN（绿） */}
            <rect class="bar-ffn" x={x + 240} y={midY - 8} width={w - 248} height={16} rx="5"
                  fill="#e6faf5" stroke="#3ec6a0" stroke-width="0.9"></rect>
            <text x={x + 248} y={midY + 3.5} font-size={fs} font-weight="700" fill="#159070">前馈FFN</text>
          </g>
        );
      })}

      <text x="300" y="494" font-size="11.5" fill="#5b7a86" text-anchor="middle">
        12 个相同 Block 堆叠（每层内部：多头自注意力 → 前馈网络，带 Norm + 残差）· 当前层高亮，点击暂停
      </text>
    </g>
    <line x1="300" y1="510" x2="300" y2="526" stroke="#94a3b8" stroke-width="2" marker-end="url(#narr)"></line>

    <!-- 4 LM Head -->
    <g font-family="-apple-system,'PingFang SC','Microsoft YaHei',sans-serif">
      <rect x="110" y="530" width="380" height="82" rx="16" fill="#ffffff" stroke="#e2e8f0" stroke-width="1.5" filter="url(#nshadow)"></rect>
      <circle cx="142" cy="560" r="15" fill="#ec7a35"></circle>
      <text x="142" y="565" font-size="15" font-weight="bold" fill="#fff" text-anchor="middle">4</text>
      <text x="168" y="560" font-size="15.5" font-weight="bold" fill="#1f2937">Final Norm → LM Head</text>
      <text x="168" y="580" font-size="12" fill="#94a3b8">把向量映射回整个词表</text>
      <text x="168" y="600" font-size="11" fill="#cbd5e1" font-family="Menlo,Monaco,monospace">shape [n, d] → [n, V]</text>
      <g>
        <rect x="372" y="576" width="9" height="26" rx="3" fill="#f5b387"></rect>
        <rect x="387" y="584" width="9" height="18" rx="3" fill="#f3a06a"></rect>
        <rect x="402" y="564" width="9" height="38" rx="3" fill="#f08b4f"></rect>
        <rect x="417" y="580" width="9" height="22" rx="3" fill="#f5b387"></rect>
        <rect x="432" y="570" width="9" height="32" rx="3" fill="#f3a06a"></rect>
        <rect x="447" y="586" width="9" height="16" rx="3" fill="#f6c3a6"></rect>
      </g>
    </g>
    <line x1="300" y1="614" x2="300" y2="632" stroke="#94a3b8" stroke-width="2" marker-end="url(#narr)"></line>

    <!-- 5 Softmax + 采样 -->
    <g font-family="-apple-system,'PingFang SC','Microsoft YaHei',sans-serif">
      <rect x="110" y="636" width="380" height="88" rx="16" fill="#ffffff" stroke="#e2e8f0" stroke-width="1.5" filter="url(#nshadow)"></rect>
      <circle cx="142" cy="666" r="15" fill="#3fa664"></circle>
      <text x="142" y="671" font-size="15" font-weight="bold" fill="#fff" text-anchor="middle">5</text>
      <text x="168" y="666" font-size="15.5" font-weight="bold" fill="#1f2937">Softmax + 采样</text>
      <text x="168" y="686" font-size="12" fill="#94a3b8">logits 变概率，挑出下一个词</text>
      <g>
        <rect x="360" y="696" width="13" height="16" rx="3" fill="#cde9d6"></rect>
        <rect x="380" y="676" width="13" height="36" rx="3" fill="#3fa664"></rect>
        <rect x="400" y="700" width="13" height="12" rx="3" fill="#cde9d6"></rect>
        <rect x="420" y="694" width="13" height="18" rx="3" fill="#a8dcc0"></rect>
      </g>
      <text x="445" y="700" font-size="18" fill="#b7c3cf">→</text>
      <rect x="456" y="682" width="42" height="28" rx="8" fill="#3fa664"></rect>
      <text x="477" y="701" font-size="14" font-weight="bold" fill="#fff" text-anchor="middle">很</text>
    </g>
  </svg>
</figure>

<style>
  .layer-card { cursor: pointer; }
  .layer-card .card-body { transform-box: fill-box; transform-origin: center; }
  .layer-card text, .layer-card rect { transition: opacity .2s ease; }
</style>

<script>
  import gsap from 'gsap';

  function initBlock() {
    const stack = document.getElementById('block-stack');
    const tip = document.getElementById('layer-tip');
    if (!stack) return;
    // L1（最底/最近）→ L12（最顶/最远）：信号自下而上
    const cards = [...stack.querySelectorAll<SVGGElement>('.layer-card')]
      .sort((a, b) => Number(a.dataset.layer) - Number(b.dataset.layer));
    const N = cards.length;

    const setActive = (c: Element | null) => {
      cards.forEach((card) => {
        const body = card.querySelector('.card-body');
        const on = card === c;
        const base = Number(card.dataset.baseOpacity ?? 1);
        gsap.to(body, {
          fill: on ? '#d4f0f9' : '#ffffff',
          stroke: on ? '#0e87a6' : '#d8e6ee',
          strokeWidth: on ? 2.6 : 1.3,
          duration: on ? 0.22 : 0.45, ease: 'power2.out',
        });
        // 高亮时整层不透明并轻微放大（远处淡层被选中时也清晰）
        gsap.to(card, {
          opacity: on ? 1 : base,
          scale: on ? 1.03 : 1,
          transformOrigin: '300px 460px',
          duration: on ? 0.22 : 0.4, ease: 'power2.out',
        });
      });
    };

    let paused = false;
    const tl = gsap.timeline({ repeat: -1, repeatDelay: 0.7 });
    cards.forEach((c, i) => {
      const layerNo = Number(c.dataset.layer);
      tl.call(() => {
        setActive(c);
        if (!paused && tip) tip.textContent = `信号穿过第 ${layerNo} / ${N} 层`;
      });
      tl.to({}, { duration: i === 0 ? 0.55 : 0.34 });
    });
    tl.call(() => setActive(null));

    // 悬停：高亮该层
    cards.forEach((c) => {
      c.addEventListener('mouseenter', () => {
        const n = Number(c.dataset.layer);
        setActive(c);
        if (tip) tip.textContent = `第 ${n} / ${N} 层 · 多头自注意力 → 前馈 FFN`;
      });
    });
    stack.addEventListener('mouseleave', () => {
      if (!paused) { tl.restart(); if (tip) tip.textContent = '× 12 层 · 自下而上 ↑'; }
    });

    // 点击暂停/继续
    stack.addEventListener('click', (e) => {
      if (!(e.target as Element).closest('.layer-card') && !(e.target as Element).closest('#block-stack')) return;
      paused = !paused;
      if (paused) { tl.pause(); if (tip) tip.textContent = '已暂停 · 点击继续'; }
      else { tl.play(); paused = false; if (tip) tip.textContent = '× 12 层 · 自下而上 ↑'; }
    });
  }
  initBlock();
</script>
