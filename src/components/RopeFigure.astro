---
// RoPE 图解：
// 左：同一对维度 = 一个平面，向量随位置旋转 0/θ/2θ（坐标轴即第 2i、2i+1 维）
// 右：Q、K 各按自己的位置旋转后，点积只取决于夹角差 (s−t)θ
// 下：多对维度 = 不同频率的“指针”，高频像分针、低频像时针
function pt(cx:number, cy:number, r:number, deg:number) {
  const a = (deg * Math.PI) / 180;
  return [cx + r * Math.cos(a), cy - r * Math.sin(a)];
}
function arcPath(cx:number, cy:number, r:number, a0:number, a1:number) {
  const [x0, y0] = pt(cx, cy, r, a0);
  const [x1, y1] = pt(cx, cy, r, a1);
  return `M ${x0.toFixed(1)} ${y0.toFixed(1)} A ${r} ${r} 0 0 0 ${x1.toFixed(1)} ${y1.toFixed(1)}`;
}
// 左图
const L = { cx: 130, cy: 158, r: 66 };
const v0 = pt(L.cx, L.cy, L.r, 0);
const v1 = pt(L.cx, L.cy, L.r, 42);
const v2 = pt(L.cx, L.cy, L.r, 84);
// 右图
const Rr = { cx: 452, cy: 158, r: 66 };
const qt = pt(Rr.cx, Rr.cy, Rr.r, 18);
const ks = pt(Rr.cx, Rr.cy, Rr.r, 72);
// 底部三个频率小图
const minis = [
  { x: 150, step: 52, label: "维度对 1：高频", sub: "转得快（分针）", color: "#e67e7e" },
  { x: 330, step: 22, label: "维度对 2：中频", sub: "转速中等", color: "#e6a23c" },
  { x: 510, step: 8,  label: "维度对 3：低频", sub: "转得慢（时针）", color: "#0f9d68" },
];
---

<figure>
  <svg viewBox="0 0 640 388" width="100%" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <marker id="rope-arr" markerWidth="8" markerHeight="8" refX="6" refY="3" orient="auto"><path d="M0,0 L7,3 L0,6 Z" fill="#475569"/></marker>
    </defs>
    <g font-family="-apple-system,'PingFang SC','Microsoft YaHei',sans-serif">
      <text x="320" y="24" font-size="14" font-weight="bold" fill="#0c5f74" text-anchor="middle">RoPE：位置不是「加上去」的，而是把 Q、K「转一个角度」</text>

      {/* ========== 左图：同一向量随位置旋转 ========== */}
      <text x="130" y="52" font-size="12.5" font-weight="bold" fill="#334155" text-anchor="middle">一对维度 = 一个平面坐标</text>
      <circle cx={L.cx} cy={L.cy} r={L.r} fill="none" stroke="#e2e8f0" stroke-dasharray="4,4"/>
      <line x1={L.cx-L.r-18} y1={L.cy} x2={L.cx+L.r+18} y2={L.cy} stroke="#cbd5e1"/>
      <line x1={L.cx} y1={L.cy+L.r+14} x2={L.cx} y2={L.cy-L.r-14} stroke="#cbd5e1"/>
      <text x={L.cx+L.r+20} y={L.cy+4} font-size="10" fill="#94a3b8">第 2i 维</text>
      <text x={L.cx+6} y={L.cy-L.r-16} font-size="10" fill="#94a3b8">第 2i+1 维</text>
      {/* v, Rθv, R2θv */}
      <line x1={L.cx} y1={L.cy} x2={v0[0]} y2={v0[1]} stroke="#94a3b8" stroke-width="2.4" marker-end="url(#rope-arr)"/>
      <line x1={L.cx} y1={L.cy} x2={v1[0]} y2={v1[1]} stroke="#0085a1" stroke-width="2.4" marker-end="url(#rope-arr)"/>
      <line x1={L.cx} y1={L.cy} x2={v2[0]} y2={v2[1]} stroke="#e6a23c" stroke-width="2.4" marker-end="url(#rope-arr)"/>
      <text x={v0[0]-6} y={v0[1]+18} font-size="11" fill="#64748b" text-anchor="end">位置 0：q</text>
      <text x={v1[0]-2} y={v1[1]-10} font-size="11" fill="#006377">位置 1：R(θ)q</text>
      <text x={v2[0]-70} y={v2[1]-6} font-size="11" fill="#b97a1f">位置 2：R(2θ)q</text>
      {/* 角度弧 */}
      <path d={arcPath(L.cx, L.cy, 24, 0, 42)} fill="none" stroke="#0085a1" stroke-width="1.6"/>
      <text x={pt(L.cx,L.cy,34,21)[0]} y={pt(L.cx,L.cy,34,21)[1]+4} font-size="10.5" fill="#0085a1">θ</text>
      <path d={arcPath(L.cx, L.cy, 40, 42, 84)} fill="none" stroke="#e6a23c" stroke-width="1.6"/>
      <text x={pt(L.cx,L.cy,50,63)[0]} y={pt(L.cx,L.cy,50,63)[1]+4} font-size="10.5" fill="#b97a1f">θ</text>
      <text x="154" y="258" font-size="10.5" fill="#64748b" text-anchor="middle">同一个内容向量：位置每加 1 就多转 θ，长度不变</text>

      {/* 分隔虚线 */}
      <line x1="298" y1="48" x2="298" y2="268" stroke="#e2e8f0" stroke-dasharray="4,4"/>

      {/* ========== 右图：夹角差 ========== */}
      <text x="452" y="52" font-size="12.5" font-weight="bold" fill="#334155" text-anchor="middle">点积只看两个向量的夹角</text>
      <circle cx={Rr.cx} cy={Rr.cy} r={Rr.r} fill="none" stroke="#e2e8f0" stroke-dasharray="4,4"/>
      <line x1={Rr.cx-Rr.r-18} y1={Rr.cy} x2={Rr.cx+Rr.r+18} y2={Rr.cy} stroke="#cbd5e1"/>
      <line x1={Rr.cx} y1={Rr.cy+Rr.r+14} x2={Rr.cx} y2={Rr.cy-Rr.r-14} stroke="#cbd5e1"/>
      <line x1={Rr.cx} y1={Rr.cy} x2={qt[0]} y2={qt[1]} stroke="#0085a1" stroke-width="2.4" marker-end="url(#rope-arr)"/>
      <line x1={Rr.cx} y1={Rr.cy} x2={ks[0]} y2={ks[1]} stroke="#e6a23c" stroke-width="2.4" marker-end="url(#rope-arr)"/>
      <text x={qt[0]+8} y={qt[1]+16} font-size="11" fill="#006377">位置 t 的 Q（转 tθ）</text>
      <text x={ks[0]-122} y={ks[1]-8} font-size="11" fill="#b97a1f">位置 s 的 K（转 sθ）</text>
      <path d={arcPath(Rr.cx, Rr.cy, 36, 18, 72)} fill="none" stroke="#b14a4a" stroke-width="2"/>
      <text x={pt(Rr.cx,Rr.cy,48,45)[0]+2} y={pt(Rr.cx,Rr.cy,48,45)[1]+4} font-size="11" font-weight="bold" fill="#b14a4a">(s−t)θ</text>
      <text x="458" y="258" font-size="10.5" fill="#64748b" text-anchor="middle">夹角等于「相对位置 × θ」：隔多远，注意力分数只由它决定</text>

      {/* ========== 底部：多频率 ========== */}
      <line x1="20" y1="286" x2="620" y2="286" stroke="#e2e8f0"/>
      <text x="320" y="306" font-size="11.5" fill="#334155" text-anchor="middle">多维向量拆成许多「维度对」，每对一个旋转频率（角度 = 位置 × 该对频率）；位置 0 / 2 / 4 时——</text>
      {minis.map((m) => (
        <g>
          <circle cx={m.x} cy="342" r="14" fill="none" stroke="#e2e8f0"/>
          {[0, 2, 4].map((pos) => {
            const [ex, ey] = pt(m.x, 342, 14, pos * m.step);
            return <line x1={m.x} y1={342} x2={ex} y2={ey} stroke={m.color} stroke-width={pos===4 ? 2.2 : 1.3}/>;
          })}
          <text x={m.x+26} y="338" font-size="10.5" fill="#334155">{m.label}</text>
          <text x={m.x+26} y="353" font-size="9.5" fill="#94a3b8">{m.sub}</text>
        </g>
      ))}
      <text x="320" y="378" font-size="10.5" fill="#94a3b8" text-anchor="middle">高频对分辨「相邻几个词」的细微位置，低频对感知「处在段落哪个区段」；多尺度频率组合起来唯一编码每个位置</text>
    </g>
  </svg>
</figure>
