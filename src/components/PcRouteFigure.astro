      <rect x="330" y="214" width="36" height="18" rx="5" fill="#e4f5ec" stroke="#0f9d68"/>
      <rect x="330" y="236" width="36" height="18" rx="5" fill="#e4f5ec" stroke="#0f9d68"/>
      <rect x="420" y="206" width="36" height="18" rx="5" fill="#e4f5ec" stroke="#0f9d68"/>
      <text x="458" y="242" font-size="9" font-weight="bold" fill="#334155">热前缀复制到多实例、分裂子树</text>

      <text x="320" y="266" font-size="11.5" font-weight="bold" fill="#334155" text-anchor="middle">
