      <text x="446" y="104" font-size="9" fill="#64748b">持有 4K 前缀</text>
      {/* 负载表：接近阈值 */}
      <rect x="520" y="90" width="52" height="7" rx="3.5" fill="#e2e8f0"/>
      <rect x="520" y="90" width="44" height="7" rx="3.5" fill="#f59e0b"/>
