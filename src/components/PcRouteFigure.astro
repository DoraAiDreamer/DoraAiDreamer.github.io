      <rect x="372" y="140" width="214" height="42" rx="9" fill="#f8fafc" stroke="#94a3b8"/>
      <text x="390" y="166" font-size="10.5" font-weight="bold" fill="#334155">实例 B</text>
      <text x="446" y="166" font-size="9" fill="#64748b">次优匹配、负载更轻</text>

      <line x1="296" y1="112" x2="370" y2="104" stroke="#0085a1" stroke-width="2" marker-end="url(#pcr-b)"/>
      <line x1="296" y1="158" x2="370" y2="160" stroke="#e6a23c" stroke-width="1.8" stroke-dasharray="5,3" marker-end="url(#pcr-o)"/>
