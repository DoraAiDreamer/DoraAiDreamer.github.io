      <rect x="30" y="110" width="74" height="44" rx="10" fill="#f8fafc" stroke="#94a3b8"/>
      <text x="67" y="138" font-size="11" font-weight="bold" fill="#334155" text-anchor="middle">新请求</text>

      {/* 网关 */}
      <rect x="150" y="62" width="146" height="146" rx="12" fill="#f2f8fa" stroke="#0085a1"/>
      <text x="223" y="84" font-size="12" font-weight="bold" fill="#0c5f74" text-anchor="middle">网关</text>
      <rect x="170" y="96" width="106" height="62" rx="8" fill="#d9eef3" stroke="#0085a1"/>
