---
// 图5：同一片 8 卡——左：1 条请求 8 卡齐算（TP）；右：8 条请求各找 1 卡（DP）
---

<figure>
  <svg viewBox="0 0 640 310" width="100%" xmlns="http://www.w3.org/2000/svg">
    <g font-family="-apple-system,'PingFang SC','Microsoft YaHei',sans-serif">
      <text x="320" y="22" font-size="14" font-weight="bold" fill="#0c5f74" text-anchor="middle">同一片 8 张卡：一条请求八卡齐算，还是八条请求各找一卡？</text>

      <line x1="320" y1="40" x2="320" y2="272" stroke="#cbd5e1" stroke-dasharray="5,4"/>

      {/* ============ 左：TP ============ */}
      <text x="160" y="48" font-size="12" font-weight="bold" fill="#006377" text-anchor="middle">TP：1 条请求，8 张卡一起算</text>

      {[0, 1, 2, 3, 4, 5, 6, 7].map((i) => {
        const gx = 40 + (i % 4) * 66;
        const gy = 86 + Math.floor(i / 4) * 52;
        return (
          <g>
            <rect x={gx} y={gy} width="52" height="38" rx="6" fill="#d9eef3" stroke="#0085a1"/>
            <text x={gx + 26} y={gy + 24} font-size="10" fill="#006377" text-anchor="middle">卡 {i + 1}</text>
          </g>
        );
      })}

      {/* 请求 A → 总线 → 8 卡 */}
      <line x1="40" y1="178" x2="280" y2="178" stroke="#0085a1" stroke-width="1.4"/>
      {[0, 1, 2, 3].map((i) => (
        <line x1={66 + i * 66} y1="178" x2={66 + i * 66} y2="176" stroke="#0085a1" stroke-width="1.4"/>
      ))}
      {[0, 1, 2, 3].map((i) => (
        <line x1={66 + i * 66} y1="178" x2={66 + i * 66} y2="124" stroke="#0085a1" stroke-width="1.2" stroke-dasharray="3,2"/>
      ))}
      <line x1="160" y1="196" x2="160" y2="178" stroke="#0085a1" stroke-width="1.4"/>
      <rect x="106" y="196" width="108" height="26" rx="6" fill="#f2f8fa" stroke="#0085a1"/>
      <text x="160" y="213" font-size="10.5" fill="#0c5f74" text-anchor="middle">请求 A（1 条）</text>

      <text x="160" y="250" font-size="10" fill="#475569" text-anchor="middle">卡间每层合稿，8 张卡共同产出 1 条回答</text>
      <text x="160" y="266" font-size="10" fill="#94a3b8" text-anchor="middle">治的是装不下与单请求延迟</text>

      {/* ============ 右：DP ============ */}
      <text x="480" y="48" font-size="12" font-weight="bold" fill="#0a7a50" text-anchor="middle">DP：8 条请求，各找 1 张卡</text>

      {/* 上排请求 A-D */}
      {[0, 1, 2, 3].map((i) => {
        const gx = 360 + i * 66;
        return (
          <g>
            <rect x={gx} y="58" width="52" height="22" rx="5" fill="#f2f8fa" stroke="#0f9d68"/>
            <text x={gx + 26} y="73" font-size="9" fill="#0a7a50" text-anchor="middle">请求 {String.fromCharCode(65 + i)}</text>
            <line x1={gx + 26} y1="80" x2={gx + 26} y2="86" stroke="#0f9d68" stroke-width="1.2" stroke-dasharray="3,2"/>
          </g>
        );
      })}
      {/* 上排卡 1-4 */}
      {[0, 1, 2, 3].map((i) => {
        const gx = 360 + i * 66;
        return (
          <g>
            <rect x={gx} y="86" width="52" height="38" rx="6" fill="#e4f5ec" stroke="#0f9d68"/>
            <text x={gx + 26} y="110" font-size="10" fill="#0a7a50" text-anchor="middle">卡 {i + 1}</text>
          </g>
        );
      })}
      {/* 下排卡 5-8 */}
      {[4, 5, 6, 7].map((i) => {
        const gx = 360 + (i - 4) * 66;
        return (
          <g>
            <rect x={gx} y="138" width="52" height="38" rx="6" fill="#e4f5ec" stroke="#0f9d68"/>
            <text x={gx + 26} y="162" font-size="10" fill="#0a7a50" text-anchor="middle">卡 {i + 1}</text>
            <line x1={gx + 26} y1="176" x2={gx + 26} y2="182" stroke="#0f9d68" stroke-width="1.2" stroke-dasharray="3,2"/>
          </g>
        );
      })}
      {/* 下排请求 E-H */}
      {[4, 5, 6, 7].map((i) => {
        const gx = 360 + (i - 4) * 66;
        return (
          <g>
            <rect x={gx} y="182" width="52" height="22" rx="5" fill="#f2f8fa" stroke="#0f9d68"/>
            <text x={gx + 26} y="197" font-size="9" fill="#0a7a50" text-anchor="middle">请求 {String.fromCharCode(65 + i)}</text>
          </g>
        );
      })}

      <text x="480" y="250" font-size="10" fill="#475569" text-anchor="middle">每卡一份完整模型，副本之间推理时不说话</text>
      <text x="480" y="266" font-size="10" fill="#94a3b8" text-anchor="middle">吞吐近 ×8；单请求延迟不变（只减排队）</text>
    </g>
  </svg>
</figure>
