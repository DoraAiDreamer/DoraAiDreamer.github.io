---
// 图2：旅程全景——tokenize → 一次 prefill → m 次 decode 循环；KV 绶带贯穿
---

<figure>
  <svg viewBox="0 0 640 250" width="100%" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <marker id="pd2-arw" markerWidth="9" markerHeight="9" refX="6" refY="3" orient="auto"><path d="M0,0 L7,3 L0,6 Z" fill="#64748b"/></marker>
    </defs>
    <g font-family="-apple-system,'PingFang SC','Microsoft YaHei',sans-serif">
      <text x="320" y="26" font-size="14" font-weight="bold" fill="#0c5f74" text-anchor="middle">一次请求的计算旅程</text>

      {/* 输入文本 */}
      <rect x="20" y="92" width="96" height="56" rx="9" fill="#f2f8fa" stroke="#0085a1"/>
      <text x="68" y="115" font-size="10.5" fill="#334155" text-anchor="middle">用户 prompt</text>
      <text x="68" y="133" font-size="9.5" fill="#64748b" text-anchor="middle">今天天气怎么</text>
      <line x1="116" y1="120" x2="138" y2="120" stroke="#64748b" stroke-width="1.5" marker-end="url(#pd2-arw)"/>
      <text x="127" y="110" font-size="9" fill="#94a3b8" text-anchor="middle">分词</text>

      {/* Prefill 大块 */}
      <rect x="142" y="80" width="118" height="80" rx="10" fill="#d9eef3" stroke="#0085a1" stroke-width="1.6"/>
      <text x="201" y="112" font-size="12" font-weight="bold" fill="#006377" text-anchor="middle">Prefill</text>
      <text x="201" y="130" font-size="9.5" fill="#006377" text-anchor="middle">n 个词一次读完</text>
      <text x="201" y="146" font-size="9.5" fill="#006377" text-anchor="middle">一生一次</text>
      <line x1="260" y1="120" x2="286" y2="120" stroke="#64748b" stroke-width="1.5" marker-end="url(#pd2-arw)"/>

      {/* Decode 循环 */}
      <rect x="290" y="86" width="72" height="68" rx="10" fill="#fdf0e0" stroke="#e6a23c" stroke-width="1.6"/>
      <text x="326" y="114" font-size="11" font-weight="bold" fill="#b97a1f" text-anchor="middle">Decode</text>
      <text x="326" y="131" font-size="9" fill="#b97a1f" text-anchor="middle">出 1 个词</text>
      <text x="326" y="145" font-size="9" fill="#b97a1f" text-anchor="middle">重复 m 次</text>
      {/* 自循环箭头 */}
      <path d="M326,82 C326,60 360,60 360,84" fill="none" stroke="#e6a23c" stroke-width="1.4" marker-end="url(#pd2-arw)"/>
      <text x="352" y="64" font-size="9" fill="#b97a1f" text-anchor="middle">×m</text>

      {/* 输出 token 逐个 */}
      {['很','好','。'].map((w,i)=>(
        <g>
          <rect x={384+i*62} y="104" width="46" height="32" rx="7" fill="#e4f5ec" stroke="#0f9d68"/>
          <text x={407+i*62} y="125" font-size="11" fill="#0a7a50" text-anchor="middle">{w}</text>
        </g>
      ))}
      <text x="492" y="128" font-size="11" fill="#94a3b8">→ 流式返回</text>

      {/* KV 绶带 */}
      <path d="M201,164 C201,196 326,200 326,164" fill="none" stroke="#7ec3d8" stroke-width="2.4"/>
      <path d="M326,164 C326,190 407,190 407,140" fill="none" stroke="#7ec3d8" stroke-width="2.4"/>
      <text x="214" y="196" font-size="10.5" fill="#006377">KV Cache：prefill 写一次，decode 每步反复读、再追加一行</text>
    </g>
  </svg>
</figure>
