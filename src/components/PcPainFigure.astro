---
// 图1（钩子）：随机扩容的两个代价——重复存（32 份副本）、还打不中（重访间隔 > churn）
---

<figure>
  <svg viewBox="0 0 640 268" width="100%" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <marker id="pcp-arw" markerWidth="8" markerHeight="8" refX="6" refY="3" orient="auto"><path d="M0,0 L7,3 L0,6 Z" fill="#94a3b8"/></marker>
    </defs>
    <g font-family="-apple-system,'PingFang SC','Microsoft YaHei',sans-serif">
      <text x="320" y="26" font-size="14" font-weight="bold" fill="#0c5f74" text-anchor="middle">随机扩容的两个代价：同一份前缀，重复存，还总是打不中</text>

      {/* 左面板：复制成 32 份 */}
      <rect x="56" y="52" width="118" height="40" rx="8" fill="#d9eef3" stroke="#0085a1"/>
      <text x="115" y="70" font-size="10.5" font-weight="bold" fill="#006377" text-anchor="middle">4K 公共前缀</text>
      <text x="115" y="84" font-size="9" fill="#64748b" text-anchor="middle">KV ≈ 512 MiB</text>

      {/* 虚线复制箭头 */}
      <path d="M80,96 C66,112 60,120 58,128" fill="none" stroke="#94a3b8" stroke-dasharray="4,3"/>
      <path d="M150,96 C166,112 178,118 196,128" fill="none" stroke="#94a3b8" stroke-dasharray="4,3"/>
      <path d="M115,96 L115,126" fill="none" stroke="#94a3b8" stroke-dasharray="4,3"/>

      {/* 8×4 小实例格 */}
      {Array.from({ length: 32 }).map((_, i) => {
        const cx = 44 + (i % 8) * 19;
        const cy = 130 + Math.floor(i / 8) * 18;
        return <rect x={cx} y={cy} width="15" height="14" rx="2.5" fill="#d9eef3" stroke="#0085a1" stroke-width="0.8"/>;
      })}
      <text x="115" y="216" font-size="10.5" font-weight="bold" fill="#b91c1c" text-anchor="middle">32 份重复副本 ≈ 16 GiB</text>

      {/* 分隔线 */}
      <line x1="266" y1="50" x2="266" y2="226" stroke="#cbd5e1" stroke-dasharray="4,4"/>

      {/* 右面板：时间轴上早早被驱逐 */}
      <text x="450" y="62" font-size="11.5" font-weight="bold" fill="#0c5f74" text-anchor="middle">每个实例的缓存时间轴</text>

      {[88, 126, 164].map((y, i) => {
        return (
        <g>
          <text x="286" y={y + 12} font-size="9" fill="#64748b">实例{i === 0 ? 3 : i === 1 ? 17 : 28}</text>
          <line x1="330" y1={y + 8} x2="604" y2={y + 8} stroke="#cbd5e1" stroke-width="2"/>
          <rect x={356 + i * 44} y={y} width="26" height="16" rx="3" fill="#d9eef3" stroke="#0085a1"/>
          <text x={369 + i * 44} y={y + 11} font-size="8" fill="#006377" text-anchor="middle">命中</text>
          <line x1={392 + i * 44} y1={y + 4} x2={392 + i * 44} y2={y + 12} stroke="#b91c1c" stroke-width="1.4"/>
          <line x1={388 + i * 44} y1={y + 4} x2={396 + i * 44} y2={y + 12} stroke="#b91c1c" stroke-width="1.4"/>
        </g>
        );
      })}
      <rect x="296" y="194" width="296" height="30" rx="8" fill="#fef2f2" stroke="#fecaca"/>
      <text x="444" y="213" font-size="10.5" font-weight="bold" fill="#b91c1c" text-anchor="middle">重访间隔 3.2 秒 &gt; churn：前缀早被驱逐，次次冷启动</text>

      <text x="320" y="250" font-size="11.5" font-weight="bold" fill="#334155" text-anchor="middle">
        扩出来的是实例数，不是有效容量——同一份前缀要么重复算，要么重复存
      </text>
    </g>
  </svg>
</figure>
