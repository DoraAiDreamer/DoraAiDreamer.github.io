---
// 单个 Transformer Block 内部结构（Pre-Norm + 残差），与总览图同一套配色
---
<figure>
  <svg viewBox="0 0 560 470" width="100%" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <marker id="b-ar" markerWidth="9" markerHeight="9" refX="5.5" refY="3" orient="auto">
        <path d="M0,0 L7,3 L0,6 Z" fill="#94a3b8"></path>
      </marker>
      <filter id="b-shadow" x="-20%" y="-20%" width="140%" height="140%">
        <feDropShadow dx="0" dy="2" stdDeviation="4" flood-color="#0b2a3a" flood-opacity="0.08"></feDropShadow>
      </filter>
    </defs>

    <g font-family="-apple-system,'PingFang SC','Microsoft YaHei',sans-serif">
      <!-- 残差侧通道（右侧） -->
      <path d="M392,46 H478 V398 H318" fill="none" stroke="#c98fd6" stroke-width="2" stroke-dasharray="6,5" marker-end="url(#b-ar)"></path>
      <text x="496" y="230" font-size="11.5" fill="#a06ce0" text-anchor="middle" transform="rotate(90 496 230)">残差连接 (Residual)</text>

      <!-- 输入 -->
      <text x="270" y="34" font-size="13.5" font-weight="bold" fill="#1f2937" text-anchor="middle">输入 x（隐藏向量 [n, d]）</text>

      <!-- Norm 1 -->
      <rect x="150" y="52" width="240" height="40" rx="10" fill="#e8f3f6" stroke="#0e87a6" stroke-width="1.5" filter="url(#b-shadow)"></rect>
      <text x="270" y="77" font-size="13" font-weight="bold" fill="#0c5f74" text-anchor="middle">RMSNorm（归一化）</text>
      <line x1="270" y1="92" x2="270" y2="112" stroke="#94a3b8" stroke-width="2" marker-end="url(#b-ar)"></line>

      <!-- 多头自注意力 -->
      <rect x="150" y="118" width="240" height="66" rx="12" fill="#eef2ff" stroke="#7c9cf0" stroke-width="1.6" filter="url(#b-shadow)"></rect>
      <text x="270" y="146" font-size="14" font-weight="bold" fill="#4255c4" text-anchor="middle">多头自注意力</text>
      <text x="270" y="166" font-size="11.5" fill="#8b95d8" text-anchor="middle">Q·K·V 加权聚合 token 间信息</text>
      <line x1="270" y1="184" x2="270" y2="196" stroke="#94a3b8" stroke-width="2" marker-end="url(#b-ar)"></line>

      <!-- ⊕ 1 -->
      <circle cx="270" cy="214" r="16" fill="#fff" stroke="#0e87a6" stroke-width="2"></circle>
      <text x="270" y="220" font-size="17" font-weight="bold" fill="#0e87a6" text-anchor="middle">+</text>
      <text x="128" y="218" font-size="11.5" fill="#94a3b8" text-anchor="end">x + Attn</text>
      <line x1="270" y1="230" x2="270" y2="252" stroke="#94a3b8" stroke-width="2" marker-end="url(#b-ar)"></line>

      <!-- Norm 2 -->
      <rect x="150" y="258" width="240" height="40" rx="10" fill="#e8f3f6" stroke="#0e87a6" stroke-width="1.5" filter="url(#b-shadow)"></rect>
      <text x="270" y="283" font-size="13" font-weight="bold" fill="#0c5f74" text-anchor="middle">RMSNorm（归一化）</text>
      <line x1="270" y1="298" x2="270" y2="318" stroke="#94a3b8" stroke-width="2" marker-end="url(#b-ar)"></line>

      <!-- FFN -->
      <rect x="150" y="324" width="240" height="66" rx="12" fill="#e6faf5" stroke="#3ec6a0" stroke-width="1.6" filter="url(#b-shadow)"></rect>
      <text x="270" y="352" font-size="14" font-weight="bold" fill="#159070" text-anchor="middle">前馈网络 FFN</text>
      <text x="270" y="372" font-size="11.5" fill="#6fbfa3" text-anchor="middle">逐 token 非线性提炼特征（升维 → 降维）</text>
      <line x1="270" y1="390" x2="270" y2="398" stroke="#94a3b8" stroke-width="2" marker-end="url(#b-ar)"></line>

      <!-- ⊕ 2 -->
      <circle cx="270" cy="414" r="16" fill="#fff" stroke="#0e87a6" stroke-width="2"></circle>
      <text x="270" y="420" font-size="17" font-weight="bold" fill="#0e87a6" text-anchor="middle">+</text>
      <text x="128" y="418" font-size="11.5" fill="#94a3b8" text-anchor="end">x + FFN</text>
      <line x1="270" y1="430" x2="270" y2="448" stroke="#94a3b8" stroke-width="2" marker-end="url(#b-ar)"></line>

      <text x="270" y="462" font-size="13.5" font-weight="bold" fill="#1f2937" text-anchor="middle">输出（送入下一层 Block）</text>
    </g>
  </svg>
</figure>
