---
// 三种并行：DP 对账 / TP 传纸条 / PP 半成品搬运
---

<figure>
  <svg viewBox="0 0 640 346" width="100%" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <marker id="prp-arw" markerWidth="8" markerHeight="8" refX="6" refY="3" orient="auto"><path d="M0,0 L7,3 L0,6 Z" fill="#94a3b8"/></marker>
    </defs>
    <g font-family="-apple-system,'PingFang SC','Microsoft YaHei',sans-serif">
      <text x="320" y="22" font-size="14" font-weight="bold" fill="#0c5f74" text-anchor="middle">把模型拆开的三种方式</text>

      {/* DP */}
      <text x="107" y="56" font-size="11" font-weight="bold" fill="#006377">数据并行（DP）</text>
      {[0,1,2].map((r)=>(
        <g>
          <rect x="60" y={68+r*30} width="100" height="22" rx="5" fill="#d9eef3" stroke="#0085a1"/>
          <text x="110" y={83+r*30} font-size="9" fill="#006377" text-anchor="middle">完整模型副本</text>
        </g>
      ))}
      <text x="110" y="170" font-size="8.5" fill="#64748b" text-anchor="middle">各自算不同批次，梯度同步</text>

      {/* TP */}
      <text x="320" y="56" font-size="11" font-weight="bold" fill="#006377">张量并行（TP，层内）</text>
      {[0,1,2,3].map((i)=>(
        <g>
          <rect x={236+i*42} y="70" width="38" height="72" rx="5" fill="#e4f5ec" stroke="#0f9d68"/>
          <text x={255+i*42} y="102" font-size="8.5" fill="#0a7a50" text-anchor="middle">卡 {i+1}</text>
          <text x={255+i*42} y="118" font-size="8" fill="#64748b" text-anchor="middle">切权重</text>
          {i<3 && <line x1={274+i*42} y1="106" x2={278+i*42} y2="106" stroke="#94a3b8" marker-end="url(#prp-arw)"/>}
        </g>
      ))}
      <text x="320" y="170" font-size="8.5" fill="#64748b" text-anchor="middle">每层矩阵切块，卡间每步高频通信</text>

      {/* PP */}
      <text x="528" y="56" font-size="11" font-weight="bold" fill="#006377">流水线并行（PP，层间）</text>
      {[0,1,2].map((i)=>(
        <g>
          <rect x={470+i*52} y="76" width="46" height="60" rx="5" fill="#fdf0e0" stroke="#e6a23c"/>
          <text x={493+i*52} y="102" font-size="8.5" fill="#b97a1f" text-anchor="middle">第{i+1}段</text>
          <text x={493+i*52} y="118" font-size="8" fill="#64748b" text-anchor="middle">若干层</text>
          {i<2 && <line x1={516+i*52} y1="106" x2={522+i*52} y2="106" stroke="#94a3b8" marker-end="url(#prp-arw)"/>}
        </g>
      ))}
      <text x="528" y="170" font-size="8.5" fill="#64748b" text-anchor="middle">激活逐段搬，有气泡</text>

      <line x1="30" y1="188" x2="610" y2="188" stroke="#e2e8f0"/>

      {/* 通信量对比 */}
      <text x="320" y="214" font-size="11" font-weight="bold" fill="#334155" text-anchor="middle">通信量与放置边界</text>
      <rect x="60" y="226" width="160" height="44" rx="7" fill="#e4f5ec" stroke="#0f9d68"/>
      <text x="140" y="245" font-size="9" font-weight="bold" fill="#0a7a50" text-anchor="middle">TP：每步都传、量大</text>
      <text x="140" y="261" font-size="8.5" fill="#475569" text-anchor="middle">必须 NVLink 机柜内</text>
      <rect x="240" y="226" width="160" height="44" rx="7" fill="#fdf0e0" stroke="#e6a23c"/>
      <text x="320" y="245" font-size="9" font-weight="bold" fill="#b97a1f" text-anchor="middle">PP：层间接力、量中</text>
      <text x="320" y="261" font-size="8.5" fill="#475569" text-anchor="middle">可跨 IB，但有气泡</text>
      <rect x="420" y="226" width="160" height="44" rx="7" fill="#d9eef3" stroke="#0085a1"/>
      <text x="500" y="245" font-size="9" font-weight="bold" fill="#006377" text-anchor="middle">DP：每轮对账、梯度</text>
      <text x="500" y="261" font-size="8.5" fill="#475569" text-anchor="middle">跨机房网络可承受</text>

      <text x="320" y="300" font-size="9.5" fill="#475569" text-anchor="middle">通信越频繁越要放在高速互联附近：TP 留 NVLink 域，DP 跨 scale-out</text>
      <text x="320" y="320" font-size="8.5" fill="#94a3b8" text-anchor="middle">生活类比仅辅助：对账 / 传纸条 / 工序接力；定义以前文机制段为准</text>
    </g>
  </svg>
</figure>
