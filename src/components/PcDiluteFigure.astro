---
// 图4：上半 随机路由稀释（全局密集 vs 单实例稀疏）；下半严格不剧透，只放三个问题
---

<figure>
  <svg viewBox="0 0 640 252" width="100%" xmlns="http://www.w3.org/2000/svg">
    <g font-family="-apple-system,'PingFang SC','Microsoft YaHei',sans-serif">
      <text x="320" y="26" font-size="14" font-weight="bold" fill="#0c5f74" text-anchor="middle">随机路由：同一前缀的到达率 ÷ N，副本数 × N</text>

      {/* 全局：密集 */}
      <text x="40" y="64" font-size="10" font-weight="bold" fill="#006377">全局</text>
      <text x="40" y="77" font-size="8.5" fill="#64748b">r=10 req/s</text>
      <line x1="116" y1="70" x2="596" y2="70" stroke="#cbd5e1" stroke-width="2"/>
      {Array.from({ length: 20 }).map((_, i) => {
        return (
          <rect x={124 + i * 23} y="63" width="10" height="14" rx="2.5" fill="#d9eef3" stroke="#0085a1" stroke-width="0.8"/>
        );
      })}

      {/* 三实例：稀疏 + 驱逐 */}
      {[104, 138, 172].map((y, i) => {
        return (
          <g>
            <text x="40" y={y + 10} font-size="9.5" font-weight="bold" fill="#64748b">实例 {[5, 19, 30][i]}</text>
            <line x1="116" y1={y + 6} x2="596" y2={y + 6} stroke="#e2e8f0" stroke-width="2"/>
            <rect x={220 + i * 90} y={y - 2} width="26" height="16" rx="3" fill="#d9eef3" stroke="#0085a1"/>
            <text x={233 + i * 90} y={y + 9} font-size="8" fill="#006377" text-anchor="middle">命中</text>
            <line x1={256 + i * 90} y1={y + 2} x2={256 + i * 90} y2={y + 10} stroke="#b91c1c" stroke-width="1.3"/>
            <line x1={252 + i * 90} y1={y + 2} x2={260 + i * 90} y2={y + 10} stroke="#b91c1c" stroke-width="1.3"/>
          </g>
        );
      })}

      {/* 下半：不剧透问号区（紫色，独立视觉语言） */}
      <line x1="40" y1="198" x2="600" y2="198" stroke="#cbd5e1" stroke-dasharray="5,4"/>
      <text x="60" y="222" font-size="11.5" font-weight="bold" fill="#6d28d9">？ 命中率为什么会掉？</text>
      <text x="330" y="222" font-size="11.5" font-weight="bold" fill="#6d28d9">？ 总容量为什么没翻倍？</text>
      <text x="60" y="242" font-size="11.5" font-weight="bold" fill="#6d28d9">？ 为什么小集群反而更好？</text>
    </g>
  </svg>
</figure>
