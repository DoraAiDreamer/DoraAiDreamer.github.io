---
// 图4：流水线气泡三格：M=1 必付填充 / M 大时填满 / prefill-decode 片重不均的等待
---

<figure>
  <svg viewBox="0 0 640 330" width="100%" xmlns="http://www.w3.org/2000/svg">
    <g font-family="-apple-system,'PingFang SC','Microsoft YaHei',sans-serif">
      <text x="320" y="22" font-size="14" font-weight="bold" fill="#0c5f74" text-anchor="middle">气泡是等出来的：填料越少等得越久，填料不匀也要等</text>

      {/* 三格公共参数：4 个工位，6 拍，步进 27；面板 x=40/242/444，间隙留足行标签 */}
      {[
        {
          x: 40, title: "单请求 M=1：P−1 跳填充照付",
          rows: [
            { t: 1, w: 1, c: "#d9eef3", s: "#0085a1", txt: "请求" },
          ],
          note: "后 3 个工位前 3 拍全空——单请求延迟必付",
        },
        {
          x: 242, title: "M 个请求灌满：气泡摊薄",
          rows: [
            { t: 1, w: 1, c: "#d9eef3", s: "#0085a1", txt: "①" },
            { t: 2, w: 1, c: "#d9eef3", s: "#0085a1", txt: "②" },
            { t: 3, w: 1, c: "#d9eef3", s: "#0085a1", txt: "③" },
            { t: 4, w: 1, c: "#d9eef3", s: "#0085a1", txt: "④" },
          ],
          note: "填料连续，只有首尾各 P−1 拍气泡",
        },
        {
          x: 444, title: "片重不匀：重片把后工位卡住",
          rows: [
            { t: 1, w: 2.6, c: "#fdf0e0", s: "#e6a23c", txt: "prefill 重片" },
            { t: 4.2, w: 0.8, c: "#d9eef3", s: "#0085a1", txt: "解" },
            { t: 5.4, w: 0.8, c: "#d9eef3", s: "#0085a1", txt: "解" },
          ],
          note: "轻片到了也得等重片——切块等重才均泡",
        },
      ].map((p) => (
        <g>
          <text x={p.x + 81} y="52" font-size="11" font-weight="bold" fill="#0c5f74" text-anchor="middle">{p.title}</text>
          {[0, 1, 2, 3].map((stage) => {
            const gy = 64 + stage * 44;
            return (
              <g>
                <text x={p.x - 8} y={gy + 18} font-size="9" fill="#64748b" text-anchor="end">工位{stage + 1}</text>
                {/* 6 拍底格 */}
                {[0, 1, 2, 3, 4, 5].map((beat) => (
                  <rect x={p.x + beat * 27} y={gy} width="26" height="30" rx="3" fill="#fafbfc" stroke="#e2e8f0"/>
                ))}
                {/* 填充 */}
                {stage === 0
                  ? p.rows.map((r) => (
                      <g>
                        <rect x={p.x + (r.t - 1) * 27 + 1} y={gy + 1} width={r.w * 27 - 2} height="28" rx="4" fill={r.c} stroke={r.s}/>
                        <text x={p.x + (r.t - 1) * 27 + (r.w * 27) / 2} y={gy + 19} font-size="9" fill="#334155" text-anchor="middle">{r.txt}</text>
                      </g>
                    ))
                  : p.rows.map((r, ri) => {
                      const t = r.t + stage;
                      if (t > 6) return null;
                      const w = Math.min(r.w, 6 - t + 1);
                      const cx = p.x + (t - 1) * 27 + (w * 27) / 2;
                      return (
                        <g>
                          <rect x={p.x + (t - 1) * 27 + 1} y={gy + 1} width={w * 27 - 2} height="28" rx="4" fill={r.c} stroke={r.s}/>
                          {((ri === 0 && w > 1.2 && stage === 1) || r.txt.length <= 1) && (
                            <text x={cx} y={gy + 19} font-size="9" fill="#334155" text-anchor="middle">{r.txt}</text>
                          )}
                        </g>
                      );
                    })}
              </g>
            );
          })}
          <text x={p.x + 81} y="258" font-size="9.5" fill="#475569" text-anchor="middle">{p.note}</text>
        </g>
      ))}

      {/* 图例 */}
      <rect x="160" y="284" width="14" height="11" rx="2" fill="#d9eef3" stroke="#0085a1"/>
      <text x="180" y="294" font-size="10" fill="#475569">等重小片</text>
      <rect x="262" y="284" width="14" height="11" rx="2" fill="#fdf0e0" stroke="#e6a23c"/>
      <text x="282" y="294" font-size="10" fill="#475569">整段 prefill 重片</text>
      <rect x="410" y="284" width="14" height="11" rx="2" fill="#fafbfc" stroke="#e2e8f0"/>
      <text x="430" y="294" font-size="10" fill="#475569">空格＝气泡（工位空闲）</text>

      <text x="320" y="318" font-size="10" fill="#64748b" text-anchor="middle">
        训练与推理都用 micro-batch 灌流水线；推理的病灶是 prefill 重片与 decode 轻片不匀，均匀切块显著减少气泡（非消除）
      </text>
    </g>
  </svg>
</figure>
