---
// 哆啦A梦头像（纯 SVG，矢量，随导航栏缩放）
const size = Astro.props.size ?? 34;
---

<svg width={size} height={size} viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="哆啦A梦">
  <!-- 蓝色头 -->
  <circle cx="32" cy="29" r="26" fill="#15a3dc"/>
  <!-- 白色脸 -->
  <ellipse cx="32" cy="33" rx="20" ry="18" fill="#ffffff"/>
  <!-- 眼睛 -->
  <ellipse cx="27.4" cy="14.6" rx="5.1" ry="6.8" fill="#fff" stroke="#333" stroke-width="1.5"/>
  <ellipse cx="36.6" cy="14.6" rx="5.1" ry="6.8" fill="#fff" stroke="#333" stroke-width="1.5"/>
  <circle cx="30.4" cy="17.6" r="1.7" fill="#333"/>
  <circle cx="33.6" cy="17.6" r="1.7" fill="#333"/>
  <!-- 红鼻子 -->
  <circle cx="32" cy="24.2" r="3.6" fill="#e6342b"/>
  <circle cx="30.7" cy="23" r="1" fill="#ffd0c8"/>
  <!-- 鼻子到嘴的竖线 -->
  <line x1="32" y1="27.8" x2="32" y2="40.5" stroke="#333" stroke-width="1.5"/>
  <!-- 笑嘴 -->
  <path d="M20.5 35.5 Q32 47 43.5 35.5" stroke="#333" stroke-width="1.5" stroke-linecap="round"/>
  <!-- 胡须 -->
  <g stroke="#333" stroke-width="1.3" stroke-linecap="round">
    <line x1="5.5" y1="27" x2="17.5" y2="29.5"/>
    <line x1="5"   y1="32.5" x2="17" y2="32.5"/>
    <line x1="5.8" y1="38" x2="17.5" y2="35.5"/>
    <line x1="58.5" y1="27" x2="46.5" y2="29.5"/>
    <line x1="59"   y1="32.5" x2="47" y2="32.5"/>
    <line x1="58.2" y1="38" x2="46.5" y2="35.5"/>
  </g>
  <!-- 红项圈 -->
  <path d="M8.5 52 Q32 65 55.5 52 L55.5 57.5 Q32 70 8.5 57.5 Z" fill="#e6342b"/>
  <!-- 黄铃铛 -->
  <circle cx="32" cy="57" r="3.4" fill="#ffd23e" stroke="#b8860b" stroke-width=".8"/>
  <line x1="28.8" y1="57" x2="35.2" y2="57" stroke="#b8860b" stroke-width=".8"/>
  <circle cx="32" cy="58.2" r=".9" fill="#b8860b"/>
</svg>
