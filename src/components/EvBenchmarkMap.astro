---
// 基准地图两联：左=客观/主观 × 单元/端到端分区（示意）；右=难度接棒时间轴
---

<figure>
  <svg viewBox="0 0 640 286" width="100%" xmlns="http://www.w3.org/2000/svg">
    <g font-family="-apple-system,'PingFang SC','Microsoft YaHei',sans-serif">
      <text x="320" y="22" font-size="14" font-weight="bold" fill="#0c5f74" text-anchor="middle">基准怎么换：按「考什么」分区，按「被刷满」接棒</text>

      <text x="150" y="52" font-size="10.5" font-weight="bold" fill="#334155" text-anchor="middle">按判分方式与任务层级（示意位置）</text>
      <rect x="56" y="62" width="190" height="178" rx="8" fill="#f8fafc" stroke="#cbd5e1"/>
      <line x1="151" y1="62" x2="151" y2="240" stroke="#e2e8f0" stroke-dasharray="3,3"/>
      <line x1="56" y1="151" x2="246" y2="151" stroke="#e2e8f0" stroke-dasharray="3,3"/>
      <text x="60" y="76" font-size="7.8" fill="#94a3b8">主观偏好 · 端到端</text>
      <text x="242" y="76" font-size="7.8" fill="#94a3b8" text-anchor="end">客观判分 · 端到端</text>
      <text x="60" y="236" font-size="7.8" fill="#94a3b8">主观偏好 · 单元</text>
      <text x="242" y="236" font-size="7.8" fill="#94a3b8" text-anchor="end">客观判分 · 单元</text>

      <g font-size="8.2" fill="#006377">
        <rect x="68" y="100" width="78" height="18" rx="4" fill="#d9eef3"/><text x="107" y="113" text-anchor="middle">Arena 对战</text>
        <rect x="68" y="124" width="78" height="18" rx="4" fill="#d9eef3"/><text x="107" y="137" text-anchor="middle">MT-Bench 裁判</text>
        <text x="107" y="170" font-size="7.6" fill="#94a3b8" text-anchor="middle">主观偏好</text>
        <rect x="158" y="82" width="76" height="16" rx="4" fill="#d9eef3"/><text x="196" y="94" text-anchor="middle">τ-bench</text>
        <rect x="158" y="102" width="76" height="16" rx="4" fill="#d9eef3"/><text x="196" y="114" text-anchor="middle">SWE-bench</text>
        <rect x="158" y="122" width="76" height="16" rx="4" fill="#d9eef3"/><text x="196" y="134" text-anchor="middle">WebArena/GAIA</text>
        <rect x="158" y="168" width="76" height="16" rx="4" fill="#e4f5ec"/><text x="196" y="180" text-anchor="middle">MMLU 文综</text>
        <rect x="158" y="188" width="76" height="16" rx="4" fill="#e4f5ec"/><text x="196" y="200" text-anchor="middle">GSM8K/HumanEval</text>
        <rect x="158" y="208" width="76" height="16" rx="4" fill="#fdf0e0" stroke="#e6a23c"/><text x="196" y="220" text-anchor="middle">GPQA/HLE</text>
      </g>

      <text x="450" y="52" font-size="10.5" font-weight="bold" fill="#334155" text-anchor="middle">数学/代码难度接棒（饱和区灰化）</text>
      <line x1="330" y1="150" x2="596" y2="150" stroke="#94a3b8" stroke-width="1.6"/>
      {[
        {x:346, t:"GSM8K", y:108, gray:true},
        {x:392, t:"MATH", y:190, gray:true},
        {x:436, t:"AIME 24/25", y:108, gray:true},
        {x:484, t:"BeyondAIME", y:190, gray:false},
        {x:540, t:"AMO/HLE", y:108, gray:false},
      ].map((n)=> (
        <g>
          <circle cx={n.x} cy="150" r="5" fill={n.gray?"#cbd5e1":"#e6a23c"}/>
          <line x1={n.x} y1="150" x2={n.x} y2={n.y+8} stroke={n.gray?"#cbd5e1":"#e6a23c"} stroke-dasharray="2,2"/>
          <text x={n.x} y={n.y} font-size="8.6" fill={n.gray?"#94a3b8":"#b97a1f"} text-anchor="middle" font-weight="bold">{n.t}</text>
        </g>
      ))}
      <text x="338" y="240" font-size="8.2" fill="#94a3b8">2021</text>
      <text x="580" y="240" font-size="8.2" fill="#94a3b8" text-anchor="end">2026</text>
      <text x="463" y="84" font-size="8" fill="#64748b" text-anchor="middle">旧榜被刷满 → 出新题/私有题/年度新考</text>

      <text x="320" y="270" font-size="9" fill="#475569" text-anchor="middle">左图位置为示意，非精确坐标；HLE 同时跨主观/客观，这里只表「难、研究级」</text>
    </g>
  </svg>
