---
// 图1（钩子）：老监控大盘全绿，用户却在转圈
// 故障链画成灰色无标签节点做悬念，正文 RequestLayersFigure 再点亮
---

<figure>
  <svg viewBox="0 0 640 318" width="100%" xmlns="http://www.w3.org/2000/svg">
    <g font-family="-apple-system,'PingFang SC','Microsoft YaHei',sans-serif">
      <text x="320" y="26" font-size="14" font-weight="bold" fill="#0c5f74" text-anchor="middle">周一早高峰：大盘全绿，用户却在等第一个字</text>

      {/* 左：老监控大盘 */}
      <rect x="30" y="48" width="268" height="196" rx="10" fill="#f4f6f8" stroke="#cbd5e1"/>
      <text x="164" y="72" font-size="12" font-weight="bold" fill="#475569" text-anchor="middle">on-call 眼里的老大盘</text>
      {[
        { y: 88, t: "CPU", v: "40%" },
        { y: 120, t: "内存", v: "富裕" },
        { y: 152, t: "网卡", v: "没满" },
        { y: 184, t: "Pod 状态", v: "Running" },
      ].map((r) => (
        <g>
          <text x="52" y={r.y + 15} font-size="11" fill="#475569">{r.t}</text>
          <text x="180" y={r.y + 15} font-size="11" fill="#64748b">{r.v}</text>
          <circle cx="262" cy={r.y + 11} r="8" fill="#e4f5ec" stroke="#0f9d68"/>
          <path d={`M258 ${r.y + 11} l3 3 l6 -7`} fill="none" stroke="#0f9d68" stroke-width="1.8"/>
        </g>
      ))}
      <text x="164" y="228" font-size="11" font-weight="bold" fill="#0a7a50" text-anchor="middle">一切正常 ✓</text>

      {/* 右：转圈的用户 */}
      <rect x="342" y="48" width="268" height="196" rx="10" fill="#fbe3e3" stroke="#e67e7e"/>
      <text x="476" y="72" font-size="12" font-weight="bold" fill="#b14a4a" text-anchor="middle">用户感受到的</text>
      <circle cx="476" cy="130" r="26" fill="none" stroke="#b14a4a" stroke-width="4" stroke-dasharray="30,132" stroke-linecap="round"/>
      <text x="476" y="186" font-size="12" fill="#b14a4a" text-anchor="middle">8 秒还不出第一个字（示意场景）</text>
      <text x="476" y="214" font-size="10.5" fill="#b14a4a" text-anchor="middle">首字延迟 P99 持续飘高</text>

      {/* 底部：灰色无标签故障链（悬念） */}
      <text x="320" y="272" font-size="11" fill="#94a3b8" text-anchor="middle">真正的故障链（此时还没有名字，后文逐个点亮）</text>
      <line x1="118" y1="294" x2="522" y2="294" stroke="#cbd5e1" stroke-dasharray="3,4"/>
      {[120, 220, 320, 420, 520].map((x) => (
        <g>
          <rect x={x - 26} y="282" width="52" height="24" rx="12" fill="#f4f6f8" stroke="#cbd5e1"/>
          <text x={x} y="298" font-size="11" fill="#94a3b8" text-anchor="middle">？</text>
        </g>
      ))}
    </g>
  </svg>
</figure>
