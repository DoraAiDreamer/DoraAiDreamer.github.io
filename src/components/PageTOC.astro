---
// 右侧页面目录：自动提取正文 h2/h3，滚动时高亮当前章节
---
<aside class="tocbar">
  <div class="toc-title">本页目录</div>
  <nav id="toc-nav"></nav>
</aside>

<script>
  function slug(s: string) {
    return s.trim().toLowerCase().replace(/\s+/g, '-').replace(/[^\w一-龥-]/g, '');
  }
  const article = document.querySelector('article.post');
  const nav = document.getElementById('toc-nav')!;
  const tocbar = document.querySelector('.tocbar') as HTMLElement;
  if (!article) { tocbar.style.display = 'none'; }
  else {
    let heads = [...article.querySelectorAll('h1, h2, h3')] as HTMLElement[];
    // 第一个 h1 是文章/页面大标题，不算章节，跳过
    if (heads.length && heads[0].tagName === 'H1') heads = heads.slice(1);
    if (!heads.length) { tocbar.style.display = 'none'; }
    const links: { a: HTMLAnchorElement; el: HTMLElement }[] = [];
    const ul = document.createElement('ul');
    ul.className = 'toc-list';
    heads.forEach((h) => {
      const id = h.id || slug(h.textContent || '');
      h.id = id;
      const li = document.createElement('li');
      li.className = h.tagName === 'H3' ? 'toc-h3' : (h.tagName === 'H2' ? 'toc-h2' : 'toc-h1');
      const a = document.createElement('a');
      a.href = `#${id}`;
      a.textContent = h.textContent || '';
      a.onclick = (e) => { e.preventDefault();
        h.scrollIntoView({ behavior: 'smooth', block: 'start' });
        history.replaceState(null, '', `#${id}`);
      };
      li.appendChild(a); ul.appendChild(li); links.push({ a, el: h });
    });
    nav.appendChild(ul);

    const setActive = (el: HTMLElement) => {
      links.forEach(({ a, el: x }) => a.classList.toggle('active', x === el));
    };
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => { if (e.isIntersecting) setActive(e.target as HTMLElement); });
      },
      { rootMargin: '-80px 0px -70% 0px' }
    );
    heads.forEach((h) => io.observe(h));
  }
</script>
