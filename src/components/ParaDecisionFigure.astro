---
// 图8：并行策略决策流程——容量→拓扑→并发→特例
---

<figure>
  <svg viewBox="0 0 640 386" width="100%" xmlns="http://www.w3.org/2000/svg">
    <g font-family="-apple-system,'PingFang SC','Microsoft YaHei',sans-serif">
      <text x="320" y="22" font-size="14" font-weight="bold" fill="#0c5f74" text-anchor="middle">先容量、再单请求延迟、最后并发：一张决策图</text>

      {/* 入口 */}
      <rect x="230" y="34" width="180" height="28" rx="14" fill="#334155"/>
      <text x="320" y="53" font-size="11" fill="#fff" text-anchor="middle">拿到模型与机器，从容量开始</text>

      {/* 六行：左问题右结论 */}
      {[
        { y: 78,  q: "① 单卡放得下，且速度够？", a: "别并行（FP8 的 70B 即此例）", ac: true,  note: "" },
        { y: 130, q: "② 装不下：卡在同一 NVLink 域？", a: "TP 填满域内卡数", ac: false, note: "无 NVLink 的高吞吐场景改用 PP；单流低延迟另测" },
        { y: 182, q: "③ 一个域还放不下？", a: "TP 留域内 × PP 跨节点", ac: false, note: "官方标准拓扑；IB 上大 TP 是例外，按每跳延迟评估" },
        { y: 234, q: "④ 装得下，但并发/吞吐不够？", a: "DP 复制副本", ac: false, note: "近线性的前提：资源独立、LB 与主机侧不瓶颈" },
        { y: 286, q: "⑤ MoE 模型？", a: "注意力走 DP/TP，专家走 EP", ac: false, note: "EP 仍标 experimental；热专家用 EPLB 均衡" },
        { y: 338, q: "⑥ 超长上下文？", a: "prefill 慢看 pcp，KV 撑显存看 dcp", ac: false, note: "pcp 仍在活跃开发；dcp 先 TP 后加，上限 tp/H" },
      ].map((r, i) => (
        <g>
          <rect x="24" y={r.y} width="276" height="38" rx="8" fill="#f2f8fa" stroke="#0085a1"/>
          <text x="162" y={r.y + 24} font-size="10.5" fill="#006377" text-anchor="middle">{r.q}</text>
          <rect x="340" y={r.y} width="276" height="38" rx="8"
                fill={r.ac ? "#e4f5ec" : "#fdf0e0"}
                stroke={r.ac ? "#0f9d68" : "#e6a23c"}/>
          <text x="478" y={r.y + 17} font-size="10.5" font-weight="bold"
                fill={r.ac ? "#0a7a50" : "#b97a1f"} text-anchor="middle">{r.a}</text>
          <text x="478" y={r.y + 32} font-size="8.8" fill="#94a3b8" text-anchor="middle">{r.note}</text>
          <path d="M300 19 h0" />
        </g>
      ))}

      {/* 是 箭头：问题→结论；否：垂直下行 */}
      {[78, 130, 182, 234, 286, 338].map((y) => (
        <line x1="300" y1={y + 19} x2="340" y2={y + 19} stroke="#0f9d68" stroke-width="1.6" marker-end="url(#arD)"/>
      ))}
      {[78, 130, 182, 234, 286].map((y) => (
        <line x1="162" y1={y + 38} x2="162" y2={y + 52} stroke="#94a3b8" stroke-width="1.5" marker-end="url(#arDG)"/>
      ))}
      <text x="172" y="105" font-size="9" fill="#94a3b8">否 ↓</text>
      <text x="312" y="92" font-size="9" fill="#0f9d68">是→</text>

      <defs>
        <marker id="arD" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto">
          <path d="M0,0 L8,4 L0,8 z" fill="#0f9d68"/>
        </marker>
        <marker id="arDG" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto">
          <path d="M0,0 L8,4 L0,8 z" fill="#94a3b8"/>
        </marker>
      </defs>
    </g>
  </svg>
</figure>
