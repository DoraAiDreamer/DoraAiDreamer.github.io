---
// 神经元 = 线性变换 + 激活；多层堆叠成 MLP（前向数据流）
---
<figure>
  <svg viewBox="0 0 600 300" width="100%" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <marker id="ff-ar" markerWidth="9" markerHeight="9" refX="6" refY="3" orient="auto">
        <path d="M0,0 L7,3 L0,6 Z" fill="#0e87a6"></path>
      </marker>
      <filter id="ff-shadow" x="-20%" y="-20%" width="140%" height="160%">
        <feDropShadow dx="0" dy="2" stdDeviation="4" flood-color="#0b2a3a" flood-opacity="0.10"></feDropShadow>
      </filter>
    </defs>
    <g font-family="-apple-system,'PingFang SC','Microsoft YaHei',sans-serif">
      <text x="300" y="26" font-size="14" font-weight="bold" fill="#0c5f74" text-anchor="middle">神经元与前向传播：线性变换 + 激活，层层堆叠</text>

      {/* 列标题 */}
      <text x="80"  y="66"  font-size="11.5" font-weight="bold" fill="#334155" text-anchor="middle">输入 x</text>
      <text x="260" y="66"  font-size="11.5" font-weight="bold" fill="#0a5f78" text-anchor="middle">隐藏层</text>
      <text x="410" y="66"  font-size="11.5" font-weight="bold" fill="#b5791f" text-anchor="middle">输出 ŷ</text>

      {/* 输入层 3 个 */}
      {[100, 150, 200].map((y) => (
        <g>
          <circle cx="80" cy={y} r="18" fill="#eef2f8" stroke="#8fa4c9" stroke-width="1.5"></circle>
          <text x="80" y={y+4} font-size="11" fill="#334155" text-anchor="middle">x{y===100?'₁':y===150?'₂':'₃'}</text>
        </g>
      ))}

      {/* 隐藏层 3 个 */}
      {[100, 150, 200].map((y, i) => (
        <g>
          <circle cx="260" cy={y} r="20" fill="#f0f9fc" stroke="#7ec3d8" stroke-width="1.5"></circle>
          <text x="260" y={y+4} font-size="10" fill="#0a5f78" text-anchor="middle">a{i+1}⁽¹⁾</text>
        </g>
      ))}

      {/* 输入 → 隐藏 的连线（9 条） */}
      {[100,150,200].map((iy) =>
        [100,150,200].map((hy) => (
          <line x1="98" y1={iy} x2="240" y2={hy} stroke="#c8d6e2" stroke-width="1"></line>
        ))
      )}

      {/* 隐藏 → 输出 的连线（3 条） */}
      {[100,150,200].map((hy) => (
        <line x1="280" y1={hy} x2="388" y2="150" stroke="#c8d6e2" stroke-width="1"></line>
      ))}

      {/* 输出层 1 个 */}
      <circle cx="410" cy="150" r="22" fill="#fdf3ec" stroke="#e6a23c" stroke-width="1.6"></circle>
      <text x="410" y="155" font-size="12" font-weight="bold" fill="#b5791f" text-anchor="middle">ŷ</text>

      {/* 层间公式说明 */}
      <text x="170" y="240" font-size="10.5" fill="#4a7284" text-anchor="middle">z = Wx + b</text>
      <text x="335" y="240" font-size="10.5" fill="#4a7284" text-anchor="middle">Wx + b</text>
      <text x="170" y="258" font-size="10.5" fill="#4a7284" text-anchor="middle">a = ReLU(z)</text>

      {/* 单个神经元放大 */}
      <rect x="462" y="96" width="118" height="120" rx="10" fill="#fafcfd" stroke="#dce8ef" filter="url(#ff-shadow)"></rect>
      <text x="521" y="120" font-size="11" font-weight="bold" fill="#0c5f74" text-anchor="middle">一个神经元</text>
      <text x="521" y="142" font-size="9.8" fill="#334155" text-anchor="middle">线性 z = w·x + b</text>
      <text x="521" y="162" font-size="9.8" fill="#334155" text-anchor="middle">激活 a = σ(z)</text>
      <text x="521" y="188" font-size="9.2" fill="#4a7284" text-anchor="middle">加权求和后</text>
      <text x="521" y="203" font-size="9.2" fill="#4a7284" text-anchor="middle">再过非线性函数</text>
    </g>
  </svg>
</figure>
