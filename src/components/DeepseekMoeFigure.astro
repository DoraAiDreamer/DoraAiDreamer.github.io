---
// DeepSeekMoE 两大创新：细粒度专家分割 + 共享专家（始终激活）
---
<figure>
  <svg viewBox="0 0 600 360" width="100%" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <filter id="dm-shadow" x="-20%" y="-20%" width="140%" height="160%">
        <feDropShadow dx="0" dy="2" stdDeviation="4" flood-color="#0b2a3a" flood-opacity="0.10"></feDropShadow>
      </filter>
    </defs>
    <g font-family="-apple-system,'PingFang SC','Microsoft YaHei',sans-serif">
      <text x="300" y="26" font-size="14" font-weight="bold" fill="#0c5f74" text-anchor="middle">DeepSeekMoE：共享专家（常亮）+ 细粒度路由专家（选 8）</text>

      <text x="20" y="62" font-size="12" font-weight="bold" fill="#b1521f">共享专家（shared）</text>
      <text x="20" y="78" font-size="10" fill="#94a3b8">每个 token 都走，承接通用知识</text>
      <!-- 共享专家：始终高亮 -->
      <rect x="150" y="50" width="200" height="42" rx="9" fill="#f5a623" stroke="#d8841a" stroke-width="1.6" filter="url(#dm-shadow)"></rect>
      <text x="250" y="76" font-size="11.5" font-weight="bold" fill="#fff" text-anchor="middle">共享专家（1 个，始终激活）</text>

      <text x="20" y="124" font-size="12" font-weight="bold" fill="#0a7a50">细粒度路由专家（routed）</text>
      <text x="20" y="140" font-size="10" fill="#94a3b8">切得更小更多，每个 token 选 Top-8</text>

      <!-- 细粒度路由专家：16 个（示意），其中 8 个高亮 -->
      {Array.from({ length: 16 }).map((_, i) => {
        const active = [0, 2, 4, 7, 9, 11, 13, 15].includes(i);
        const x = 150 + (i % 4) * 78;
        const y = 112 + Math.floor(i / 4) * 52;
        return (
          <g>
            <rect x={x} y={y} width="70" height="40" rx="7"
                  fill={active ? '#0f9d68' : '#eef1f6'}
                  stroke={active ? '#0a7a50' : '#d6dce5'} stroke-width={active ? '1.6' : '1'}
                  opacity={active ? 1 : 0.75}></rect>
            <text x={x+35} y={y+25} font-size="10" font-weight={active ? 'bold' : 'normal'}
                  fill={active ? '#fff' : '#a3adbd'} text-anchor="middle">
              {active ? `专家${i+1} ✓` : `专家${i+1}`}
            </text>
          </g>
        );
      })}

      <!-- 结果汇总 -->
      <rect x="150" y="322" width="200" height="30" rx="8" fill="#eef2f8" stroke="#8fa4c9"></rect>
      <text x="250" y="341" font-size="11" font-weight="bold" fill="#334155" text-anchor="middle">加权汇总 → 输出</text>
    </g>
  </svg>
</figure>
