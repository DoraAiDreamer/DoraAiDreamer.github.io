---
// 图1（钩子）：140GB 的 70B 模型 vs 两张 80GB 卡，三种摆法，副本摆法红叉
---

<figure>
  <svg viewBox="0 0 640 300" width="100%" xmlns="http://www.w3.org/2000/svg">
    <g font-family="-apple-system,'PingFang SC','Microsoft YaHei',sans-serif">
      <text x="320" y="24" font-size="14" font-weight="bold" fill="#0c5f74" text-anchor="middle">70B（FP16）≈ 140GB，两张 80GB 的卡怎么摆？</text>

      {/* 左：模型与单卡容量对比 */}
      <text x="40" y="58" font-size="11" fill="#475569">模型权重</text>
      <rect x="110" y="44" width="280" height="20" rx="4" fill="#d9eef3" stroke="#0085a1"/>
      <text x="250" y="58" font-size="11" fill="#006377" text-anchor="middle">140GB</text>
      <text x="40" y="92" font-size="11" fill="#475569">一张 H100</text>
      <rect x="110" y="78" width="160" height="20" rx="4" fill="#f4f6f8" stroke="#cbd5e1"/>
      <text x="190" y="92" font-size="11" fill="#64748b" text-anchor="middle">80GB</text>
      <text x="285" y="92" font-size="11" fill="#b14a4a">140 &gt; 80，单卡连加载都做不到</text>

      <line x1="30" y1="112" x2="610" y2="112" stroke="#e2e8f0"/>

      {/* 三种摆法 */}
      {/* ① TP 雏形 */}
      <g>
        <rect x="24" y="126" width="188" height="150" rx="10" fill="#f2f8fa" stroke="#0085a1"/>
        <text x="118" y="148" font-size="11.5" font-weight="bold" fill="#006377" text-anchor="middle">① 层内切两半，合算一条</text>
        <rect x="44" y="164" width="70" height="44" rx="6" fill="#d9eef3" stroke="#0085a1"/>
        <text x="79" y="183" font-size="10" fill="#006377" text-anchor="middle">卡 0</text>
        <text x="79" y="198" font-size="9.5" fill="#0c5f74" text-anchor="middle">半个模型 70GB</text>
        <rect x="124" y="164" width="70" height="44" rx="6" fill="#d9eef3" stroke="#0085a1"/>
        <text x="159" y="183" font-size="10" fill="#006377" text-anchor="middle">卡 1</text>
        <text x="159" y="198" font-size="9.5" fill="#0c5f74" text-anchor="middle">半个模型 70GB</text>
        <path d="M114 186 h10" stroke="#64748b" stroke-width="1.5" marker-end="url(#arrG)"/>
        <text x="118" y="234" font-size="10" fill="#0f9d68" text-anchor="middle">装得下（TP 的雏形）</text>
        <text x="118" y="256" font-size="9.5" fill="#64748b" text-anchor="middle">每层要停下来对答案</text>
      </g>

      {/* ② PP 雏形 */}
      <g>
        <rect x="226" y="126" width="188" height="150" rx="10" fill="#f2f8fa" stroke="#0085a1"/>
        <text x="320" y="148" font-size="11.5" font-weight="bold" fill="#006377" text-anchor="middle">② 前后 40 层，分工位</text>
        <rect x="246" y="164" width="70" height="44" rx="6" fill="#d9eef3" stroke="#0085a1"/>
        <text x="281" y="183" font-size="10" fill="#006377" text-anchor="middle">卡 0</text>
        <text x="281" y="198" font-size="9.5" fill="#0c5f74" text-anchor="middle">第 1–40 层</text>
        <rect x="326" y="164" width="70" height="44" rx="6" fill="#d9eef3" stroke="#0085a1"/>
        <text x="361" y="183" font-size="10" fill="#006377" text-anchor="middle">卡 1</text>
        <text x="361" y="198" font-size="9.5" fill="#0c5f74" text-anchor="middle">第 41–80 层</text>
        <path d="M316 186 h10" stroke="#64748b" stroke-width="1.5" marker-end="url(#arrG)"/>
        <text x="320" y="234" font-size="10" fill="#0f9d68" text-anchor="middle">装得下（PP 的雏形）</text>
        <text x="320" y="256" font-size="9.5" fill="#64748b" text-anchor="middle">只在交界处递一次工件</text>
      </g>

      {/* ③ DP 红叉 */}
      <g>
        <rect x="428" y="126" width="188" height="150" rx="10" fill="#fbe3e3" stroke="#e67e7e"/>
        <text x="522" y="148" font-size="11.5" font-weight="bold" fill="#b14a4a" text-anchor="middle">③ 每卡放一份完整副本</text>
        <rect x="448" y="164" width="70" height="44" rx="6" fill="#f4f6f8" stroke="#b14a4a" stroke-dasharray="4,3"/>
        <text x="483" y="183" font-size="10" fill="#64748b" text-anchor="middle">卡 0</text>
        <text x="483" y="198" font-size="9.5" fill="#b14a4a" text-anchor="middle">140GB？</text>
        <rect x="528" y="164" width="70" height="44" rx="6" fill="#f4f6f8" stroke="#b14a4a" stroke-dasharray="4,3"/>
        <text x="563" y="183" font-size="10" fill="#64748b" text-anchor="middle">卡 1</text>
        <text x="563" y="198" font-size="9.5" fill="#b14a4a" text-anchor="middle">140GB？</text>
        <line x1="455" y1="158" x2="597" y2="214" stroke="#b14a4a" stroke-width="3"/>
        <text x="522" y="234" font-size="10" font-weight="bold" fill="#b14a4a" text-anchor="middle">✗ 80 &lt; 140，放不下</text>
        <text x="522" y="256" font-size="9.5" fill="#b14a4a" text-anchor="middle">复制副本是装得下之后的奢侈</text>
      </g>

      <defs>
        <marker id="arrG" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto">
          <path d="M0,0 L8,4 L0,8 z" fill="#64748b"/>
        </marker>
      </defs>
    </g>
  </svg>
</figure>
