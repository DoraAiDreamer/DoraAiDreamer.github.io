---
// 图5：V1 中一个物理块的生命周期
// 空闲 → 分配写入 → 写满打 hash（可被共享/APC 命中）→ 释放回池（带 hash 可命中，LRU 驱逐）
// 抢占：请求的块全部释放，请求回队首重算（V1 只有 recompute）
---

<figure>
  <svg viewBox="0 0 640 252" width="100%" xmlns="http://www.w3.org/2000/svg">
    <defs><marker id="pa5-arw" markerWidth="9" markerHeight="9" refX="6" refY="3" orient="auto"><path d="M0,0 L7,3 L0,6 Z" fill="#64748b"/></marker></defs>
    <g font-family="-apple-system,'PingFang SC','Microsoft YaHei',sans-serif">
      <text x="320" y="24" font-size="14" font-weight="bold" fill="#0c5f74" text-anchor="middle">一个物理块的一生（vLLM V1）</text>

      {/* 状态节点 */}
      {[
        { x: 70,  y: 100, w: 96,  t: "空闲", st: "在块池中", fill:"#f4f6f8", stroke:"#cbd5e1", tc:"#64748b" },
        { x: 206, y: 100, w: 96,  t: "分配写入", st: "新 token 追加", fill:"#fdf0e0", stroke:"#e6a23c", tc:"#b97a1f" },
        { x: 342, y: 100, w: 110, t: "写满·打 hash", st: "不可变 / 可共享", fill:"#d9eef3", stroke:"#0085a1", tc:"#006377" },
        { x: 486, y: 100, w: 110, t: "释放回池", st: "带 hash 等命中", fill:"#e4f5ec", stroke:"#0f9d68", tc:"#0a7a50" },
      ].map((b)=>(
        <g>
          <rect x={b.x} y={b.y-26} width={b.w} height="52" rx="9" fill={b.fill} stroke={b.stroke} stroke-width="1.5"/>
          <text x={b.x+b.w/2} y={b.y-4} font-size="12" font-weight="bold" fill={b.tc} text-anchor="middle">{b.t}</text>
          <text x={b.x+b.w/2} y={b.y+14} font-size="9.5" fill="#64748b" text-anchor="middle">{b.st}</text>
        </g>
      ))}
      {[166,302,452].map((x)=>(
        <line x1={x} y1="100" x2={x+34} y2="100" stroke="#64748b" stroke-width="1.6" marker-end="url(#pa5-arw)"/>
      ))}

      {/* 分支：共享（标签放在满块节点正上方） */}
      <line x1="397" y1="74" x2="397" y2="58" stroke="#0085a1" stroke-dasharray="4,3"/>
      <rect x="318" y="34" width="158" height="24" rx="7" fill="#f7fbfc" stroke="#7ec3d8"/>
      <text x="397" y="50" font-size="10" fill="#006377" text-anchor="middle">其他请求命中前缀，refcnt+1</text>

      {/* 分支：LRU 驱逐回空闲 */}
      <path d="M541,126 C541,176 118,176 118,128" fill="none" stroke="#94a3b8" stroke-width="1.4" stroke-dasharray="5,4" marker-end="url(#pa5-arw)"/>
      <text x="330" y="196" font-size="10.5" fill="#64748b" text-anchor="middle">长期无人引用 → LRU 驱逐，格子回到空闲</text>

      {/* 抢占路径 */}
      <rect x="190" y="208" width="260" height="30" rx="7" fill="#fbe3e3" stroke="#e67e7e"/>
      <text x="320" y="227" font-size="10.5" fill="#b14a4a" text-anchor="middle">显存不足→最晚到的请求整块释放、回队首重算（V1 只重算）</text>
      <line x1="254" y1="126" x2="294" y2="206" stroke="#e67e7e" stroke-width="1.3" stroke-dasharray="4,3" marker-end="url(#pa5-arw)"/>
    </g>
  </svg>
</figure>
