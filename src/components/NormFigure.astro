---
// 归一化图解：BatchNorm（按列/特征跨样本）vs LayerNorm（按行/样本跨特征）
// 矩阵每格一个特征值，颜色表示激活大小，红框标出各自做归一化的方向
---
<figure>
  <svg viewBox="0 0 600 470" width="100%" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <marker id="nf-ar" markerWidth="9" markerHeight="9" refX="5.5" refY="3" orient="auto">
        <path d="M0,0 L7,3 L0,6 Z" fill="#94a3b8"></path>
      </marker>
      <filter id="nf-shadow" x="-20%" y="-20%" width="140%" height="140%">
        <feDropShadow dx="0" dy="2" stdDeviation="4" flood-color="#0b2a3a" flood-opacity="0.10"></feDropShadow>
      </filter>
    </defs>

    <g font-family="-apple-system,'PingFang SC','Microsoft YaHei',sans-serif" text-anchor="middle">
      <!-- ============ 左：BatchNorm ============ -->
      <text x="150" y="26" font-size="15" font-weight="bold" fill="#0e87a6">BatchNorm（CV 常用）</text>
      <text x="150" y="46" font-size="11.5" fill="#94a3b8">沿 batch（跨样本）、按每个特征维统计 μ / σ</text>

      <!-- 列头 x1..x4 -->
      <g font-size="11" fill="#5b8a96" font-weight="700">
        <text x="95"  y="74">x₁</text><text x="132" y="74">x₂</text>
        <text x="169" y="74">x₃</text><text x="206" y="74">x₄</text>
      </g>
      <!-- 行头 样本1..4 -->
      <g font-size="11" fill="#5b8a96" font-weight="700" text-anchor="end">
        <text x="78" y="97">样本1</text><text x="78" y="134">样本2</text>
        <text x="78" y="171">样本3</text><text x="78" y="208">样本4</text>
      </g>
      <!-- 网格：按列着色深浅（同列同一色，表达按列统计） -->
      {Array.from({ length: 4 }).map((_, r) =>
        Array.from({ length: 4 }).map((_, c) => {
          const cols = ['#bde3f0', '#f6d9a8', '#c9e7c2', '#eec9d6'];
          return (
            <rect x={82 + c * 37} y={82 + r * 37} width="32" height="30" rx="5"
                  fill={cols[c]} stroke="#ffffff" stroke-width="2"></rect>
          );
        })
      )}
      <!-- 列方向归一化（红框圈整列 + 上下箭头） -->
      <rect x="127" y="80" width="37" height="152" rx="8" fill="none" stroke="#e67a35" stroke-width="2.2"
            stroke-dasharray="5,4"></rect>
      <line x1="145" y1="240" x2="145" y2="258" stroke="#e67a35" stroke-width="2" marker-end="url(#nf-ar)"></line>
      <text x="150" y="276" font-size="11" fill="#b5601f">对「同一特征列」跨 4 个样本求 μ、σ</text>

      <!-- ============ 右：LayerNorm ============ -->
      <text x="450" y="26" font-size="15" font-weight="bold" fill="#0e87a6">LayerNorm（NLP/LLM 常用）</text>
      <text x="450" y="46" font-size="11.5" fill="#94a3b8">沿特征（跨维度）、每个样本独立统计 μ / σ</text>

      <g font-size="11" fill="#5b8a96" font-weight="700">
        <text x="395" y="74">x₁</text><text x="432" y="74">x₂</text>
        <text x="469" y="74">x₃</text><text x="506" y="74">x₄</text>
      </g>
      <g font-size="11" fill="#5b8a96" font-weight="700" text-anchor="end">
        <text x="378" y="97">样本1</text><text x="378" y="134">样本2</text>
        <text x="378" y="171">样本3</text><text x="378" y="208">样本4</text>
      </g>
      <!-- 网格：按行着色（同行同一色，表达按行统计） -->
      {Array.from({ length: 4 }).map((_, r) =>
        Array.from({ length: 4 }).map((_, c) => {
          const rows = ['#bde3f0', '#f6d9a8', '#c9e7c2', '#eec9d6'];
          return (
            <rect x={382 + c * 37} y={82 + r * 37} width="32" height="30" rx="5"
                  fill={rows[r]} stroke="#ffffff" stroke-width="2"></rect>
          );
        })
      )}
      <!-- 行方向归一化（红框圈整行 + 右箭头） -->
      <rect x="380" y="82" width="152" height="32" rx="8" fill="none" stroke="#7c9cf0" stroke-width="2.2"
            stroke-dasharray="5,4"></rect>
      <line x1="540" y1="98" x2="558" y2="98" stroke="#7c9cf0" stroke-width="2" marker-end="url(#nf-ar)"></line>
      <text x="450" y="276" font-size="11" fill="#4255c4">对「同一个样本」跨 4 个特征求 μ、σ</text>

      <!-- 底部：归一化后 -->
      <line x1="150" y1="294" x2="150" y2="312" stroke="#94a3b8" stroke-width="2" marker-end="url(#nf-ar)"></line>
      <line x1="450" y1="294" x2="450" y2="312" stroke="#94a3b8" stroke-width="2" marker-end="url(#nf-ar)"></line>
      <rect x="60" y="316" width="180" height="98" rx="14" fill="#ffffff" stroke="#d8e6ee" filter="url(#nf-shadow)"></rect>
      <text x="150" y="344" font-size="12.5" font-weight="bold" fill="#0c5f74">标准化后</text>
      <text x="150" y="368" font-size="12" fill="#475569">μ = 0，σ = 1</text>
      <text x="150" y="390" font-size="12" fill="#475569">各维度尺度统一</text>

      <rect x="360" y="316" width="180" height="98" rx="14" fill="#ffffff" stroke="#d8e6ee" filter="url(#nf-shadow)"></rect>
      <text x="450" y="344" font-size="12.5" font-weight="bold" fill="#0c5f74">标准化后</text>
      <text x="450" y="368" font-size="12" fill="#475569">每个 token 内部 μ=0, σ=1</text>
      <text x="450" y="390" font-size="12" fill="#475569">不依赖 batch 大小</text>

      <text x="300" y="444" font-size="11.5" fill="#5b7a86">BatchNorm 统计维度在 batch×特征，依赖 batch 且对变长序列不友好；LayerNorm/RMSNorm 在样本内部统计，适合 NLP</text>
    </g>
  </svg>
</figure>
