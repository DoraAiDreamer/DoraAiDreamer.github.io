      <rect x="436" y="152" width="168" height="84" rx="8" fill="#d9eef3" stroke="#0085a1"/>
      <text x="520" y="172" font-size="9.5" font-weight="bold" fill="#006377" text-anchor="middle">结构化剪层/削维 + 蒸馏</text>
