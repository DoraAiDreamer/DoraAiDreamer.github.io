---
// 图：选型决策树——先问目标货币（存储 / kernel 算术 / 任意后端可跑的小 dense 模型）
---

<figure>
  <svg viewBox="0 0 640 262" width="100%" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <marker id="prd-arw" markerWidth="8" markerHeight="8" refX="6" refY="3" orient="auto"><path d="M0,0 L7,3 L0,6 Z" fill="#94a3b8"/></marker>
    </defs>
    <g font-family="-apple-system,'PingFang SC','Microsoft YaHei',sans-serif">
      <text x="320" y="22" font-size="14" font-weight="bold" fill="#0c5f74" text-anchor="middle">先问目标货币，再选剪枝路线</text>

      {/* 根节点 */}
      <rect x="230" y="40" width="180" height="34" rx="8" fill="#d9eef3" stroke="#0085a1" stroke-width="1.6"/>
      <text x="320" y="61" font-size="10.5" font-weight="bold" fill="#006377" text-anchor="middle">要兑换成什么？</text>

      {/* 三分支 */}
      <line x1="270" y1="74" x2="118" y2="104" stroke="#94a3b8" marker-end="url(#prd-arw)"/>
      <line x1="320" y1="74" x2="320" y2="104" stroke="#94a3b8" marker-end="url(#prd-arw)"/>
      <line x1="370" y1="74" x2="522" y2="104" stroke="#94a3b8" marker-end="url(#prd-arw)"/>

      <rect x="40" y="106" width="160" height="26" rx="6" fill="#f4f6f8" stroke="#cbd5e1"/>
      <text x="120" y="123" font-size="9.5" fill="#334155" text-anchor="middle">LLM 在线推理提速</text>
      <rect x="240" y="106" width="160" height="26" rx="6" fill="#f4f6f8" stroke="#cbd5e1"/>
      <text x="320" y="123" font-size="9.5" fill="#334155" text-anchor="middle">GPU kernel 算术量</text>
      <rect x="440" y="106" width="160" height="26" rx="6" fill="#f4f6f8" stroke="#cbd5e1"/>
      <text x="520" y="123" font-size="9.5" fill="#334155" text-anchor="middle">要一个小 dense 模型</text>

      {/* 方案盒 */}
      <line x1="120" y1="132" x2="120" y2="150" stroke="#94a3b8" marker-end="url(#prd-arw)"/>
      <rect x="36" y="152" width="168" height="84" rx="8" fill="#e4f5ec" stroke="#0f9d68"/>
      <text x="120" y="172" font-size="9.5" font-weight="bold" fill="#0a7a50" text-anchor="middle">先量化（W8A8/W4A16）</text>
      <text x="120" y="190" font-size="8.5" fill="#0a7a50" text-anchor="middle">2:4+量化仅在小 batch</text>
