      <text x="120" y="222" font-size="8.5" fill="#5aa588" text-anchor="middle">直接砍权重带宽</text>

      <line x1="320" y1="132" x2="320" y2="150" stroke="#94a3b8" marker-end="url(#prd-arw)"/>
      <rect x="236" y="152" width="168" height="84" rx="8" fill="#fdf0e0" stroke="#e6a23c"/>
      <text x="320" y="172" font-size="9.5" font-weight="bold" fill="#b97a1f" text-anchor="middle">2:4 半结构化</text>
      <text x="320" y="190" font-size="8.5" fill="#b97a1f" text-anchor="middle">Ampere+ Sparse Tensor Core</text>
      <text x="320" y="204" font-size="8.5" fill="#b97a1f" text-anchor="middle">prefill 大 GEMM 近 2×</text>
      <text x="320" y="222" font-size="8.5" fill="#c99a4f" text-anchor="middle">需对齐形状 + 逐层验证</text>

