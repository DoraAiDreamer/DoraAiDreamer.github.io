---
// 图：GPU 硬件层级（GH100/H100）——嵌套包含式：die ⊃ GPC ⊃ TPC ⊃ SM；右侧 SM ⊃ 4×SMSP
---

<figure>
  <svg viewBox="0 0 640 446" width="100%" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <marker id="cph-arw" markerWidth="8" markerHeight="8" refX="6" refY="3" orient="auto"><path d="M0,0 L7,3 L0,6 Z" fill="#94a3b8"/></marker>
    </defs>
    <g font-family="-apple-system,'PingFang SC','Microsoft YaHei',sans-serif">
      <text x="320" y="22" font-size="14" font-weight="bold" fill="#0c5f74" text-anchor="middle">单颗 die 内部的硬件层级（框中框即包含关系，以 GH100 为例）</text>

      {/* ===== 左：die 嵌套图 ===== */}
      <!-- L0: die -->
      <rect x="16" y="40" width="298" height="372" rx="12" fill="#f2fafd" stroke="#0085a1" stroke-width="2"/>
      <rect x="16" y="40" width="298" height="24" rx="12" fill="#0085a1"/>
      <rect x="16" y="54" width="298" height="10" fill="#0085a1"/>
      <text x="30" y="57" font-size="10.5" font-weight="bold" fill="#fff">L0 · die（GH100）</text>
      <text x="306" y="57" font-size="7.6" fill="#dff1f6" text-anchor="end">8 GPC · 72 TPC · 144 SM（SXM 启用 132）</text>

      {/* die 直属资源 */}
      <rect x="28" y="76" width="132" height="30" rx="6" fill="#fff" stroke="#94a3b8"/>
      <text x="94" y="89" font-size="8.5" font-weight="bold" fill="#334155" text-anchor="middle">L2 Cache（分 slice）</text>
      <text x="94" y="100" font-size="7.8" fill="#64748b" text-anchor="middle">全卡共享 · 50MB</text>
      <rect x="170" y="76" width="132" height="30" rx="6" fill="#fff" stroke="#94a3b8"/>
      <text x="236" y="89" font-size="8.5" font-weight="bold" fill="#334155" text-anchor="middle">显存控制器 + I/O</text>
      <text x="236" y="100" font-size="7.8" fill="#64748b" text-anchor="middle">外接 HBM 颗粒</text>

      {/* L1: GPC（展开 1 个代表，其余省略） */}
      <rect x="28" y="118" width="274" height="240" rx="10" fill="#f2fbf7" stroke="#0f9d68" stroke-width="1.6"/>
      <rect x="28" y="118" width="274" height="20" rx="10" fill="#0f9d68"/>
      <rect x="28" y="130" width="274" height="8" fill="#0f9d68"/>
      <text x="40" y="133" font-size="9" font-weight="bold" fill="#fff">L1 · GPC 图形/计算集群</text>
      <text x="294" y="133" font-size="7.8" fill="#e2f5ec" text-anchor="end">die 上共 8 个，同构，此处展开 1 个</text>

      {/* L2: TPC 3x3（实际 9 个/GPC） */}
      {[0,1,2,3,4,5,6,7,8].map((i)=>{
        const col=i%3, row=Math.floor(i/3);
        const x=40+col*88, y=150+row*68;
        return (
          <g>
            <rect x={x} y={y} width="80" height="58" rx="7" fill="#fffdf5" stroke="#e6a23c" stroke-width="1.4"/>
            <text x={x+40} y={y+12} font-size="7.6" font-weight="bold" fill="#b97a1f" text-anchor="middle">L2 · TPC</text>
            {/* L3: 2 个 SM */}
            <rect x={x+7} y={y+20} width="30" height="30" rx="4" fill="#0085a1"/>
            <text x={x+22} y={y+33} font-size="7" font-weight="bold" fill="#fff" text-anchor="middle">SM</text>
            <text x={x+22} y={y+43} font-size="6.6" fill="#dff1f6" text-anchor="middle">L3</text>
            <rect x={x+43} y={y+20} width="30" height="30" rx="4" fill="#0085a1"/>
            <text x={x+58} y={y+33} font-size="7" font-weight="bold" fill="#fff" text-anchor="middle">SM</text>
            <text x={x+58} y={y+43} font-size="6.6" fill="#dff1f6" text-anchor="middle">L3</text>
          </g>
        );
      })}
      <text x="302" y="376" font-size="7.8" fill="#64748b" text-anchor="end">每个 GPC 含 9 个 TPC；每个 TPC 含 2 个 SM</text>
      <text x="26" y="398" font-size="8" fill="#b14a4a">注意：一颗 GPU 不一定只有一颗 die——B200 在一个封装内缝了 2 个</text>
      <text x="26" y="409" font-size="8" fill="#b14a4a">reticle die（NV-HBI 互联），下列层级在每颗 die 内各有一份</text>

      {/* 放大指示 */}
      <line x1="314" y1="300" x2="338" y2="300" stroke="#94a3b8" stroke-dasharray="4,3" marker-end="url(#cph-arw)"/>
      <text x="326" y="292" font-size="8" fill="#94a3b8" text-anchor="middle">放大</text>

      {/* ===== 右：SM 嵌套放大 ===== */}
      <rect x="342" y="40" width="282" height="276" rx="12" fill="#fdf6ec" stroke="#e6a23c" stroke-width="2"/>
      <rect x="342" y="40" width="282" height="24" rx="12" fill="#e6a23c"/>
      <rect x="342" y="54" width="282" height="10" fill="#e6a23c"/>
      <text x="356" y="57" font-size="10.5" font-weight="bold" fill="#fff">L3 · 一个 SM 放大（H100）</text>

      {/* L4: 4 个 SMSP */}
      {[0,1,2,3].map((i)=>{
        const x=352+i*67;
        return (
          <g>
            <rect x={x} y="76" width="61" height="150" rx="7" fill="#fff" stroke="#0085a1" stroke-width="1.3"/>
            <rect x={x} y="76" width="61" height="16" rx="7" fill="#d9eef3"/>
            <rect x={x} y="84" width="61" height="8" fill="#d9eef3"/>
            <text x={x+30.5} y="88" font-size="7.4" font-weight="bold" fill="#006377" text-anchor="middle">L4 SMSP {i+1}</text>
            <text x={x+30.5} y="106" font-size="7" fill="#475569" text-anchor="middle">Warp 调度器</text>
            <text x={x+30.5} y="120" font-size="7" fill="#475569" text-anchor="middle">寄存器分片</text>
            <text x={x+30.5} y="134" font-size="7" fill="#475569" text-anchor="middle">32 CUDA core</text>
            <text x={x+30.5} y="148" font-size="7" fill="#475569" text-anchor="middle">1 Tensor Core</text>
            <text x={x+30.5} y="162" font-size="7" fill="#475569" text-anchor="middle">LD/ST 访存</text>
            <text x={x+30.5} y="176" font-size="7" fill="#475569" text-anchor="middle">SFU 特殊函数</text>
            <text x={x+30.5} y="200" font-size="6.8" fill="#94a3b8" text-anchor="middle">每调度单位</text>
            <text x={x+30.5} y="210" font-size="6.8" fill="#94a3b8" text-anchor="middle">= 32 线程/warp</text>
          </g>
        );
      })}
      <text x="483" y="242" font-size="7.6" fill="#475569" text-anchor="middle">4 个 SMSP ×（32 FP32 + 1 Tensor Core）= 128 CUDA core / 4 Tensor Core</text>

      {/* SM 级共享资源 */}
      <rect x="352" y="252" width="182" height="28" rx="6" fill="#d9eef3" stroke="#0085a1"/>
      <text x="443" y="264" font-size="7.4" font-weight="bold" fill="#006377" text-anchor="middle">寄存器堆 256KB</text>
      <text x="443" y="275" font-size="7.4" font-weight="bold" fill="#006377" text-anchor="middle">L1/Shared 256KB（共享池）</text>
      <rect x="540" y="252" width="74" height="28" rx="6" fill="#fde2b8" stroke="#e6a23c"/>
      <text x="577" y="264" font-size="7.4" font-weight="bold" fill="#b97a1f" text-anchor="middle">TMA</text>
      <text x="577" y="275" font-size="6.8" fill="#8a6a30" text-anchor="middle">Hopper+ 异步搬运</text>
      <text x="483" y="298" font-size="7.2" fill="#94a3b8" text-anchor="middle">寄存器分片物理分属 4 个 SMSP，逻辑统一分配；TMA 批量搬数据不占计算单元</text>

      {/* 软件层级 */}
      <rect x="342" y="330" width="282" height="82" rx="10" fill="#fff" stroke="#cbd5e1" stroke-dasharray="4,3"/>
      <text x="483" y="349" font-size="9" font-weight="bold" fill="#334155" text-anchor="middle">软件层级（编程抽象，不在芯片上）</text>
      <text x="483" y="369" font-size="8.3" fill="#475569" text-anchor="middle">Grid（网格）</text>
      <text x="483" y="383" font-size="8.3" fill="#475569" text-anchor="middle">└ Thread Block（线程块，驻留一个 SM）</text>
      <text x="483" y="397" font-size="8.3" fill="#475569" text-anchor="middle">　 └ Warp（32 线程，硬件调度单位）→ Thread</text>
    </g>
  </svg>
</figure>
