---
// 可折叠的「扩展内容」卡片：默认收起，点击展开，不打断正文阅读
const { title = '展开扩展内容' } = Astro.props;
---

<details class="expand">
  <summary>
    <span class="expand-icon" aria-hidden="true">▸</span>
    <span class="expand-title">{title}</span>
  </summary>
  <div class="expand-body">
    <slot />
  </div>
</details>

<style>
  .expand {
    margin: 1.4em 0; border: 1px solid var(--border); border-radius: 12px;
    background: color-mix(in srgb, var(--accent-soft) 35%, var(--surface));
    overflow: hidden;
  }
  .expand summary {
    list-style: none; cursor: pointer; padding: 13px 18px; display: flex;
    align-items: center; gap: 9px; font-weight: 700; font-size: 14.5px; color: var(--accent);
    user-select: none;
  }
  .expand summary::-webkit-details-marker { display: none; }
  .expand summary:hover { background: color-mix(in srgb, var(--accent) 8%, transparent); }
  .expand-icon { transition: transform .22s ease; display: inline-block; font-size: 13px; }
  .expand[open] .expand-icon { transform: rotate(90deg); }
  .expand-body { padding: 2px 20px 16px; border-top: 1px dashed var(--border); }
  .expand-body :global(p:first-child) { margin-top: 14px; }
  .expand-body :global(table) { margin: 1em 0; }
</style>
